 <!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Objective Subjects</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
    
    
    <link
    href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
    rel="stylesheet"
>
   
   
    
  <style>
   
    .search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #f1f3f5;
    border-radius: 25px;
    padding: 12px 18px;
    margin: 20px 0;
}

.search-bar i {
    font-size: 20px;
    color: #666;
}

.search-bar input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 15px;
    font-family: inherit;
}

.no-results {
    display: none;
    text-align: center;
    color: #777;
    padding: 30px 0;
}
    
    .back-btn {

            display: inline-block;

            margin-bottom: 15px;

            text-decoration: none;

            color: #2563eb;

            font-weight: bold;

        }
    
    </style>

</head>

<body>

<div class="container">

  <a
        href="/objective-pdfs"
        class="back-btn"
    >
        ← Back to Semesters
    </a>


    <h1>📝 Objective Past Questions</h1>

    <h2><%= semester %></h2>

    <p>
        Select a subject to view available past questions.
    </p>

       <% if (subjects.length === 0) { %>
    <p>No objective past questions available for this semester yet.</p>
    
<% } else { %>


    <div class="search-bar">
    
    <i class='bx bx-search'></i>
    
    <input type="text" id="subjectSearch" placeholder="Search subjects..."></div>
    
    
    <div id="subjects">
    
        <% subjects.forEach((subject, index) => { %>
            <a href="/objective-pdfs/semester/<%= encodeURIComponent(semester) %>/subject/<%= encodeURIComponent(subject) %>" class="btn subject" data-subject="<%= subject.toLowerCase() %>">
            
            <%= index + 1 %>. <%= subject %>
            
            </a>
            
        <% }) %>
        
        
    </div>
    
    
    <p class="no-results" id="noResults">
    No subjects match your search.
    </p>
    
    
<% } %>

   

</div>



<script>

const searchInput = document.getElementById("subjectSearch");
const subjectLinks = document.querySelectorAll(".btn.subject");
const noResults = document.getElementById("noResults");

searchInput.addEventListener("input", function() {

    const query = searchInput.value.trim().toLowerCase();

    let visibleCount = 0;

    subjectLinks.forEach(function(link) {

        const subjectName = link.getAttribute("data-subject");

        if (subjectName.includes(query)) {
            link.style.display = "";
            visibleCount++;
        } else {
            link.style.display = "none";
        }

    });

    noResults.style.display = visibleCount === 0 ? "block" : "none";

});

</script>

</body>

</html>
