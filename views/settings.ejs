<!DOCTYPE html>
<html>

<head>

    <title>Settings - Yunerx</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/mobile.css" media="(max-width: 767px)">
    <link rel="stylesheet" href="/desktop.css" media="(min-width: 1024px)">

    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <style>

        .settings-container{

            width: 85%;
            max-width: 800px;

            margin: auto;
            margin-top: 90px;
            margin-bottom: 100px;

            background: white;

            padding: 25px;

            border-radius: 20px;

            box-shadow: 0 0 20px rgba(0,0,0,0.1);

        }

        .settings-title{

            text-align: center;

            color: #2563eb;

            margin-bottom: 30px;

            font-size: 35px;

        }

        .setting-card{

            background: #f3f4f6;

            padding: 18px;

            border-radius: 15px;

            margin-bottom: 18px;

            display: flex;

            justify-content: space-between;

            align-items: center;

            transition: 0.3s ease;

        }

        .setting-card:hover{

            transform: translateY(-3px);

            box-shadow: 0 0 15px rgba(0,0,0,0.1);

        }

        .setting-left{

            display: flex;

            align-items: center;

            gap: 15px;

        }

        .setting-left i{

            font-size: 28px;

            color: #2563eb;

        }

        .setting-text h3{

            margin-bottom: 3px;

        }

        .setting-text p{

            color: gray;

            font-size: 14px;

        }

        .setting-btn{

            background: #2563eb;

            color: white;

            border: none;

            padding: 10px 15px;

            border-radius: 8px;

            cursor: pointer;

            transition: 0.3s ease;

        }

        .setting-btn:hover{

            background: #1d4ed8;

        }

        .danger{

            background: #dc2626;

        }

        .danger:hover{

            background: #b91c1c;

        }

        .version{

            text-align: center;

            margin-top: 30px;

            color: gray;

            font-size: 14px;

        }

        .back-btn i{
          position: relative;
          display: flex;
          flex-direction: flex-start;
          font-size: 20px;
          height: 50px;
          width: 50px;
          justify-content: center;
          align-items: center;
          cursor: pointer;
     
        }

        .back-btn i:hover{
          background: #f5f5f5;
          border-radius: 50px;
  
        }
        
.profile-upload-form{

    display:flex;

    flex-direction:column;

    gap:15px;

    margin-top:-10px;

    margin-bottom:25px;

}

.profile-upload-form input{

    background:#f3f4f6;

    padding:12px;

    border-radius:10px;

    border:1px solid #ddd;

}
 
.profile-upload-form button{

    width:100%;

}


.delete-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 20px;
}

.delete-modal-overlay.show {
    display: flex;
}

.delete-modal {
    background: white;
    border-radius: 16px;
    padding: 26px;
    max-width: 380px;
    width: 100%;
}

.delete-modal h3 {
    margin-bottom: 10px;
    color: #dc2626;
}

.delete-modal p {
    color: #555;
    font-size: 14px;
    margin-bottom: 18px;
    line-height: 1.5;
}

.delete-modal input {
    width: 100%;
    padding: 12px;
    border-radius: 10px;
    border: 1px solid #ddd;
    background: #f3f4f6;
    margin-bottom: 16px;
    box-sizing: border-box;
}

.delete-modal-buttons {
    display: flex;
    gap: 10px;
}

.delete-modal-buttons button {
    flex: 1;
}

.settings-alert {
    padding: 12px 16px;
    border-radius: 10px;
    margin-bottom: 18px;
    font-size: 14px;
    font-weight: 600;
}

.settings-alert.error {
    background: #fbeceb;
    color: #c0392b;
}

.settings-alert.success {
    background: #eafaf1;
    color: #1e8449;
}


    </style>

</head>

<body>

<div class="settings-container">


<% if (typeof error !== "undefined" && error) { %>
    <div class="settings-alert error"><%= error %></div>
<% } %>

<% if (typeof success !== "undefined" && success) { %>
    <div class="settings-alert success"><%= success %></div>
<% } %>


   <div onclick="history.back()" class="back-btn">
    <i class='bx bx-arrow-back'></i>
   </div>


    <h1 class="settings-title">
        Settings
    </h1>

       <!-- PROFILE SETTINGS -->

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-user'></i>

            <div class="setting-text">

                <h3>Username</h3>

                <p>Current: <%= user.username %></p>

            </div>

        </div>

        <button type="button" class="setting-btn" id="editUsernameBtn">
            Edit
        </button>

    </div>

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-envelope'></i>

            <div class="setting-text">

                <h3>Email</h3>

                <p>Current: <%= user.email %></p>

            </div>

        </div>

        <button type="button" class="setting-btn" id="editEmailBtn">
            Edit
        </button>

    </div>

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-phone'></i>

            <div class="setting-text">

                <h3>Phone Number</h3>

                <p>Current: <%= user.phone %></p>

            </div>

        </div>

        <button type="button" class="setting-btn" id="editPhoneBtn">
            Edit
        </button>

    </div>

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-lock'></i>

            <div class="setting-text">

                <h3>Password</h3>

                <p>Change your account password</p>

            </div>

        </div>

        <button type="button" class="setting-btn" id="editPasswordBtn">
            Edit
        </button>

    </div>


    <!-- EDIT USERNAME MODAL -->
    <div class="delete-modal-overlay" id="usernameModalOverlay">
        <div class="delete-modal">
            <h3 style="color:#2563eb;">Change Username</h3>
            <p>You can change this up to 2 times per month.</p>
            <form action="/change-username" method="POST">
                <input type="text" name="username" placeholder="New username" minlength="4" maxlength="20" required>
                <div class="delete-modal-buttons">
                    <button type="button" class="setting-btn" id="cancelUsernameBtn">Cancel</button>
                    <button type="submit" class="setting-btn">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- EDIT EMAIL MODAL -->
    <div class="delete-modal-overlay" id="emailModalOverlay">
        <div class="delete-modal">
            <h3 style="color:#2563eb;">Change Email</h3>
            <p>You can change this up to 2 times per month.</p>
            <form action="/change-email" method="POST">
                <input type="email" name="email" placeholder="New email" required>
                <div class="delete-modal-buttons">
                    <button type="button" class="setting-btn" id="cancelEmailBtn">Cancel</button>
                    <button type="submit" class="setting-btn">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- EDIT PHONE MODAL -->
    <div class="delete-modal-overlay" id="phoneModalOverlay">
        <div class="delete-modal">
            <h3 style="color:#2563eb;">Change Phone Number</h3>
            <p>You can change this up to 2 times per month.</p>
            <form action="/change-phone" method="POST">
                <input type="text" name="phone" placeholder="New phone number" required>
                <div class="delete-modal-buttons">
                    <button type="button" class="setting-btn" id="cancelPhoneBtn">Cancel</button>
                    <button type="submit" class="setting-btn">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- EDIT PASSWORD MODAL -->
    <div class="delete-modal-overlay" id="passwordModalOverlay">
        <div class="delete-modal">
            <h3 style="color:#2563eb;">Change Password</h3>
            <p>You can change this up to 2 times per month.</p>
            <form action="/change-password" method="POST">
                <input type="password" name="currentPassword" placeholder="Current password" required>
                <input type="password" name="newPassword" placeholder="New password" minlength="8" maxlength="20" required>
                <div class="delete-modal-buttons">
                    <button type="button" class="setting-btn" id="cancelPasswordBtn">Cancel</button>
                    <button type="submit" class="setting-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
    
    
    
            <!-- PROFILE PHOTO -->

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-image'></i>

            <div class="setting-text">

                <h3>Profile Picture</h3>

                <p>Upload or change your profile picture</p>

            </div>

        </div>

        <div style="display:flex; gap:8px;">

            <button type="button" class="setting-btn" id="changePhotoBtn">
                Change
            </button>

            <% if (user && user.profileImage && user.profileImage !== "/profile.png") { %>

                <button type="button" class="setting-btn danger" id="removePhotoBtn">
                    Remove
                </button>

            <% } %>

        </div>

    </div>


    <!-- REMOVE CONFIRMATION MODAL -->

    <div class="delete-modal-overlay" id="removePhotoOverlay">

        <div class="delete-modal">

            <h3 style="color:#dc2626;">Remove profile picture?</h3>

            <p>This will reset your profile picture to the default. You can upload a new one anytime.</p>

            <form action="/remove-profile-picture" method="POST">

                <div class="delete-modal-buttons">
                    <button type="button" class="setting-btn" id="cancelRemovePhotoBtn">Cancel</button>
                    <button type="submit" class="setting-btn danger">Remove</button>
                </div>

            </form>

        </div>

    </div>


    <!-- HIDDEN UPLOAD FORM -->

    <form
        action="/upload-profile-picture"
        method="POST"
        enctype="multipart/form-data"
        id="profileUploadForm"
        style="display:none;"
    >
        <input
            type="file"
            name="profilePic"
            id="profilePicInput"
            accept="image/*"
            required
        >
    </form>


    <!-- PROFILE PHOTO PREVIEW MODAL -->

    <div class="delete-modal-overlay" id="photoPreviewOverlay">

        <div class="delete-modal">

            <h3 style="color:#2563eb;">Update profile picture?</h3>

            <div style="text-align:center; margin-bottom:18px;">

                <img
                    id="photoPreviewImage"
                    style="
                        width:120px;
                        height:120px;
                        border-radius:50%;
                        object-fit:cover;
                        border:3px solid royalblue;
                    "
                >

            </div>

            <div class="delete-modal-buttons">
                <button type="button" class="setting-btn" id="cancelPhotoBtn">Cancel</button>
                <button type="button" class="setting-btn" id="confirmPhotoBtn">Upload</button>
            </div>

        </div>

    </div>
    <!-- DARK MODE -->

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-moon'></i>

            <div class="setting-text">

                <h3>Dark Mode</h3>

                <p>Switch between light and dark theme</p>

            </div>

        </div>

        <button class="setting-btn">
            Enable
        </button>

    </div>

    <!-- NOTIFICATIONS -->

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-bell'></i>

            <div class="setting-text">

                <h3>Notifications</h3>

                <p>Manage app alerts and notifications</p>

            </div>

        </div>

        <button class="setting-btn">
            Manage
        </button>

    </div>

    <!-- PRIVACY -->

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-lock-alt'></i>

            <div class="setting-text">

                <h3>Privacy & Security</h3>

                <p>Control account privacy and security</p>

            </div>

        </div>

        <button class="setting-btn">
            Open
        </button>

    </div>

    <!-- CHAT -->

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-message-rounded'></i>

            <div class="setting-text">

                <h3>Chat Settings</h3>

                <p>Manage chats, seen status, and messages</p>

            </div>

        </div>

        <button class="setting-btn">
            Open
        </button>

    </div>

    <!-- VIDEO -->

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-video'></i>

            <div class="setting-text">

                <h3>Video Settings</h3>

                <p>Manage uploads and video preferences</p>

            </div>

        </div>

        <button class="setting-btn">
            Open
        </button>

    </div>

    <!-- ACCOUNT -->

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-shield'></i>

            <div class="setting-text">

                <h3>Account Security</h3>

                <p>Password and login protection</p>

            </div>

        </div>

        <button class="setting-btn">
            Secure
        </button>

    </div>

    <!-- LOGOUT -->

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-log-out'></i>

            <div class="setting-text">

                <h3>Logout</h3>

                <p>Sign out from your account</p>

            </div>

        </div>

        <a href="/logout">

            <button class="setting-btn danger">
                Logout
            </button>

        </a>

    </div>

       <!-- DELETE -->

    <div class="setting-card">

        <div class="setting-left">

            <i class='bx bx-trash'></i>

            <div class="setting-text">

                <h3>Delete Account</h3>

                <p>Permanently remove your account</p>

            </div>

        </div>

        <button type="button" class="setting-btn danger" id="deleteAccountBtn">
            Delete
        </button>

    </div>


    <!-- DELETE CONFIRMATION MODAL -->

    <div class="delete-modal-overlay" id="deleteModalOverlay">

        <div class="delete-modal">

            <h3>Delete your account?</h3>

            <p>This permanently removes your account and cannot be undone. Enter your password to confirm.</p>

            <form action="/delete-account" method="POST" id="deleteAccountForm">

                <input
                    type="password"
                    name="password"
                    placeholder="Your password"
                    required
                >

                <div class="delete-modal-buttons">
                    <button type="button" class="setting-btn" id="cancelDeleteBtn">Cancel</button>
                    <button type="submit" class="setting-btn danger">Delete My Account</button>
                </div>

            </form>

        </div>

    </div>

    <div class="version">

        Yunerx Version 1.0.0

    </div>

</div>


<script>

const deleteAccountBtn = document.getElementById("deleteAccountBtn");
const deleteModalOverlay = document.getElementById("deleteModalOverlay");
const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");

deleteAccountBtn.addEventListener("click", () => {
    deleteModalOverlay.classList.add("show");
});

cancelDeleteBtn.addEventListener("click", () => {
    deleteModalOverlay.classList.remove("show");
});


const changePhotoBtn = document.getElementById("changePhotoBtn");
const profilePicInput = document.getElementById("profilePicInput");
const profileUploadForm = document.getElementById("profileUploadForm");

const photoPreviewOverlay = document.getElementById("photoPreviewOverlay");
const photoPreviewImage = document.getElementById("photoPreviewImage");
const cancelPhotoBtn = document.getElementById("cancelPhotoBtn");
const confirmPhotoBtn = document.getElementById("confirmPhotoBtn");

// Clicking "Change" opens the file picker
changePhotoBtn.addEventListener("click", () => {
    profilePicInput.click();
});

// Once a file is picked, show a preview in the modal
profilePicInput.addEventListener("change", () => {

    const file = profilePicInput.files[0];

    if (!file) {
        return;
    }

    const reader = new FileReader();

    reader.onload = (event) => {
        photoPreviewImage.src = event.target.result;
        photoPreviewOverlay.classList.add("show");
    };

    reader.readAsDataURL(file);

});

// Cancel: close the modal and clear the selected file
cancelPhotoBtn.addEventListener("click", () => {
    photoPreviewOverlay.classList.remove("show");
    profilePicInput.value = "";
});

// Confirm: actually submit the form to upload
confirmPhotoBtn.addEventListener("click", () => {
    profileUploadForm.submit();
});


const removePhotoBtn = document.getElementById("removePhotoBtn");
const removePhotoOverlay = document.getElementById("removePhotoOverlay");
const cancelRemovePhotoBtn = document.getElementById("cancelRemovePhotoBtn");

if (removePhotoBtn) {

    removePhotoBtn.addEventListener("click", () => {
        removePhotoOverlay.classList.add("show");
    });

}

if (cancelRemovePhotoBtn) {

    cancelRemovePhotoBtn.addEventListener("click", () => {
        removePhotoOverlay.classList.remove("show");
    });

}



function setupEditModal(btnId, overlayId, cancelId) {

    const btn = document.getElementById(btnId);
    const overlay = document.getElementById(overlayId);
    const cancelBtn = document.getElementById(cancelId);

    btn.addEventListener("click", () => {
        overlay.classList.add("show");
    });

    cancelBtn.addEventListener("click", () => {
        overlay.classList.remove("show");
    });

}

setupEditModal("editUsernameBtn", "usernameModalOverlay", "cancelUsernameBtn");
setupEditModal("editEmailBtn", "emailModalOverlay", "cancelEmailBtn");
setupEditModal("editPhoneBtn", "phoneModalOverlay", "cancelPhoneBtn");
setupEditModal("editPasswordBtn", "passwordModalOverlay", "cancelPasswordBtn");


</script>


</body>
</html>
