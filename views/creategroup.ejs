<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create Group</title>
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #f5f7fb;
    color: #1a1a1a;
    font-family: Arial, Helvetica, sans-serif;
}

.chat-container {
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    padding: 20px;
}

.create-group-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
}

.back-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: white;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    flex-shrink: 0;
}

.back-btn:hover {
    background: #f0f0f0;
}

.create-group-header h1 {
    font-size: 20px;
    font-weight: 600;
}

.create-group-card {
    background: white;
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.06);
}

.create-group-card .icon-preview {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #eef2fb;
    color: #4169e1;
    font-size: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
}

.create-group-card label {
    font-size: 13px;
    color: #888;
    font-weight: 600;
    display: block;
    margin-bottom: 8px;
}

.create-group-card input {
    width: 100%;
    height: 48px;
    border: 1px solid #eee;
    background: #f5f7fb;
    border-radius: 10px;
    padding: 0 16px;
    font-size: 15px;
    outline: none;
    margin-bottom: 20px;
}

.create-group-card input:focus {
    border-color: #4169e1;
}

.create-group-card button {
    width: 100%;
    height: 48px;
    border: none;
    background: #4169e1;
    color: white;
    font-size: 15px;
    font-weight: 600;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.create-group-card button:hover {
    background: #3557c7;
}

</style>

</head>
<body>

<div class="chat-container">

    <div class="create-group-header">
        <a href="javascript:history.back()" class="back-btn">
            <i class='bx bx-arrow-back'></i>
        </a>
        <h1>Create Group</h1>
    </div>

    <div class="create-group-card">

        <div class="icon-preview">
            <i class='bx bx-group'></i>
        </div>

        <form action="/creategroup" method="POST">

            <label for="groupName">Group name</label>

            <input
                type="text"
                id="groupName"
                name="groupName"
                placeholder="e.g. Class 3B Study Group"
                required
            >

            <button type="submit">
                <i class='bx bx-check'></i>
                Create Group
            </button>

        </form>

    </div>

</div>

</body>
</html>
