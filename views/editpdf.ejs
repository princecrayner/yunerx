<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Theory Past Question</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>


<body>


<div class="container">

    <h1>
        ✏ Edit Theory Past Question
    </h1>


    <form
        action="/admin/edit-pdf/<%= pdf._id %>"
        method="POST"
    >


        <input
            type="text"
            name="title"
            value="<%= pdf.title %>"
            placeholder="Past Question Title"
            required
        >

        <br><br>


        <input
            type="text"
            name="subject"
            value="<%= pdf.subject %>"
            placeholder="Subject"
            required
        >

        <br><br>


        <input
            type="text"
            name="level"
            value="<%= pdf.level %>"
            placeholder="Level"
            required
        >

        <br><br>


        <input
            type="text"
            name="semester"
            value="<%= pdf.semester %>"
            placeholder="Semester"
            required
        >

        <br><br>


        <input
            type="text"
            name="category"
            value="<%= pdf.category %>"
            placeholder="Category"
            required
        >

        <br><br>


        <button
            class="btn"
            type="submit"
        >
            💾 Save Changes
        </button>


    </form>


    <br>


    <a
        href="/admin"
        class="btn"
    >
        ← Back to Admin
    </a>

</div>


</body>

</html>