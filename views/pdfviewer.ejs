<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= subject %> - Viewer</title>

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #525659;
    font-family: Arial, Helvetica, sans-serif;
    height: 100vh;
    overflow: hidden;
}

.viewer-page {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

.viewer-header {
    background: white;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    flex-shrink: 0;
    z-index: 10;
}

.viewer-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
}

.back-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #f1f3f5;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 20px;
    flex-shrink: 0;
    border: none;
    cursor: pointer;
}

.back-btn:hover {
    background: #e2e6ea;
}

.viewer-title {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.download-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #4169e1;
    color: white;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    flex-shrink: 0;
}

.download-btn:hover {
    background: #3557c7;
}

.viewer-body {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0 40px;
    gap: 16px;
}

.pdf-page-canvas {
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    max-width: 95%;
    background: white;
}

.viewer-status {
    color: white;
    text-align: center;
    padding: 40px 20px;
    font-size: 15px;
}

.viewer-status .loading-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(255,255,255,0.3);
    border-top: 3px solid white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 14px;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.page-nav {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.75);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    z-index: 10;
}

</style>

</head>
<body>

<div class="viewer-page">

    <div class="viewer-header">

        <div class="viewer-header-left">
            <a href="javascript:history.back()" class="back-btn">
                <i class='bx bx-arrow-back'></i>
            </a>
            <span class="viewer-title"><%= subject %></span>
        </div>

        <a href="<%= downloadUrl %>" class="download-btn">
            <i class='bx bx-download'></i>
            Download
        </a>

    </div>

    <div class="viewer-body" id="viewerBody">

        <div class="viewer-status" id="viewerStatus">
            <div class="loading-spinner"></div>
            <div>Loading document...</div>
        </div>

    </div>

</div>

<div class="page-nav" id="pageNav" style="display:none;"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

<script>

pdfjsLib.GlobalWorkerOptions.workerSrc =
    "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

const viewerBody = document.getElementById("viewerBody");
const viewerStatus = document.getElementById("viewerStatus");
const pageNav = document.getElementById("pageNav");

const pdfUrl = "<%= viewUrl %>";

async function renderPdf() {

    try {

        const loadingTask = pdfjsLib.getDocument(pdfUrl);
        const pdf = await loadingTask.promise;

        viewerStatus.remove();

        pageNav.style.display = "block";
        pageNav.textContent = `${pdf.numPages} page${pdf.numPages > 1 ? "s" : ""}`;

        for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber++) {

            const page = await pdf.getPage(pageNumber);

            const containerWidth = viewerBody.clientWidth * 0.95;
            const unscaledViewport = page.getViewport({ scale: 1 });
            const scale = containerWidth / unscaledViewport.width;
            const viewport = page.getViewport({ scale });

            const canvas = document.createElement("canvas");
            canvas.className = "pdf-page-canvas";
            canvas.width = viewport.width;
            canvas.height = viewport.height;

            const context = canvas.getContext("2d");

            viewerBody.appendChild(canvas);

            await page.render({
                canvasContext: context,
                viewport: viewport
            }).promise;

        }

    } catch (error) {

        console.error("PDF render error:", error);

        viewerStatus.innerHTML = `
            <i class='bx bx-error-circle' style="font-size: 40px; margin-bottom: 10px; display:block;"></i>
            <div>Unable to load this document for preview.</div>
        `;

    }

}

renderPdf();

</script>

</body>
</html>
