<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - Viewer</title>

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #f5f7fb;
    font-family: Arial, Helvetica, sans-serif;
    height: 100vh;
    overflow: hidden;
}

.viewer-page {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

.viewer-header {
    background: white;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    flex-shrink: 0;
}

.viewer-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
}

.back-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #f1f3f5;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 20px;
    flex-shrink: 0;
}

.back-btn:hover {
    background: #e2e6ea;
}

.viewer-title {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.download-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #4169e1;
    color: white;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    flex-shrink: 0;
}

.download-btn:hover {
    background: #3557c7;
}

.viewer-frame-container {
    flex: 1;
    overflow: hidden;
}

.viewer-frame-container iframe {
    width: 100%;
    height: 100%;
    border: none;
}

</style>

</head>
<body>

<div class="viewer-page">

    <div class="viewer-header">

        <div class="viewer-header-left">
            <a href="javascript:history.back()" class="back-btn">
                <i class='bx bx-arrow-back'></i>
            </a>
            <span class="viewer-title"><%= title %></span>
        </div>

        <a href="<%= downloadUrl %>" class="download-btn">
            <i class='bx bx-download'></i>
            Download
        </a>

    </div>

    <div class="viewer-frame-container">
        <iframe src="<%= viewUrl %>"></iframe>
    </div>

</div>

</body>
</html>
