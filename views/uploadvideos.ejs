<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Upload Video - Yunerx</title>

<link rel="stylesheet" href="/style.css">

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>


/* ============================================
   YUNERX — VIDEO UPLOAD PAGE
   Responsive: Mobile / Tablet / Desktop
   ============================================ */

body.page-upload {
    margin: 0;
    padding: 0 0 110px;
    min-height: 100vh;
    background: #f7f9fc;
    color: #172033;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
}

.upload-page,
.upload-page * {
    box-sizing: border-box;
}

.upload-page [hidden] {
    display: none !important;
}

.upload-page {
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    padding: 25px 20px 50px;
}

/* ============================================
   HEADER
   ============================================ */

.upload-page .upload-header {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 0 0 22px;
    margin-bottom: 28px;
    border-bottom: 1px solid #e5e9f0;
}

.upload-page .upload-header h1 {
    margin: 0;
    color: #172033;
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -0.5px;
}

.upload-page .upload-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    padding: 0;
    border: 1px solid #e4e8ef;
    border-radius: 13px;
    background: #fff;
    color: #253047;
    font-size: 24px;
    cursor: pointer;
    transition: 0.2s ease;
}

.upload-page .upload-back:hover {
    background: #edf4ff;
    border-color: #bdd6ff;
    color: #0866ff;
    transform: translateX(-2px);
}

/* ============================================
   MAIN UPLOAD CARD
   ============================================ */

.upload-page .upload-card {
    width: 100%;
    padding: 38px;
    border: 1px solid #e8ecf2;
    border-radius: 22px;
    background: #fff;
    box-shadow:
        0 4px 12px rgba(20, 35, 65, 0.025),
        0 16px 45px rgba(20, 35, 65, 0.045);
}

.upload-page #uploadForm {
    display: flex;
    flex-direction: column;
    gap: 0;
}

/* ============================================
   VIDEO TITLE INPUT
   ============================================ */

.upload-page input[type="text"] {
    display: block;
    width: 100%;
    height: 54px;
    margin: 0 0 28px;
    padding: 0 17px;
    border: 1.5px solid #dce3ed;
    border-radius: 12px;
    background: #fbfcfe;
    color: #172033;
    font-family: inherit;
    font-size: 15px;
    font-weight: 500;
    outline: none;
    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}

.upload-page input[type="text"]::placeholder {
    color: #939eae;
    font-weight: 400;
}

.upload-page input[type="text"]:focus {
    border-color: #0866ff;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(8, 102, 255, 0.09);
}

/* ============================================
   LONG VIDEO / SHORT SELECTOR
   ============================================ */

.upload-page .type-toggle {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 28px;
}

.upload-page .type-option {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 62px;
    padding: 15px 12px;
    border: 1.5px solid #e1e6ef;
    border-radius: 13px;
    background: #f8fafd;
    color: #566176;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s ease;
}

.upload-page .type-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
}

.upload-page .type-option span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
}

.upload-page .type-option:hover {
    border-color: #8bb9ff;
    background: #f0f6ff;
    color: #0866ff;
}

.upload-page .type-option:has(input:checked) {
    border-color: #0866ff;
    background: #edf4ff;
    color: #0866ff;
    box-shadow: 0 0 0 1px rgba(8, 102, 255, 0.08);
}

.upload-page .type-option:has(input:focus-visible) {
    outline: 3px solid rgba(8, 102, 255, 0.3);
    outline-offset: 3px;
}

/* ============================================
   VIDEO FILE PICKER
   ============================================ */

.upload-page .file-picker {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    width: 100%;
    min-height: 265px;
    margin-bottom: 25px;
    padding: 35px 20px;
    border: 2px dashed #b8cbed;
    border-radius: 18px;
    background: #f8fbff;
    color: #53647e;
    text-align: center;
    cursor: pointer;
    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        transform 0.2s ease;
}

.upload-page .file-picker i {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 78px;
    height: 78px;
    border-radius: 22px;
    background: #e7f0ff;
    color: #0866ff;
    font-size: 43px;
    transition: 0.2s ease;
}

.upload-page .file-picker span {
    display: block;
    max-width: 100%;
    color: #35435c;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.6;
    overflow-wrap: anywhere;
}

@media (hover: hover) and (pointer: fine) {
    .upload-page .file-picker:hover {
        border-color: #0866ff;
        background: #edf5ff;
        transform: translateY(-2px);
    }

    .upload-page .file-picker:hover i {
        background: #dceaff;
        transform: translateY(-3px);
    }
}

.upload-page .file-picker.invalid {
    border-color: #ef4444;
    background: #fff5f5;
}

.upload-page .file-picker.invalid i {
    background: #fee2e2;
    color: #dc2626;
}

/* ============================================
   VIDEO PREVIEW
   ============================================ */

.upload-page .video-preview-box {
    position: relative;
    width: 100%;
    margin-bottom: 25px;
    padding: 12px;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    background: #f8fafc;
    overflow: hidden;
}

.upload-page .video-preview-box video {
    display: block;
    width: 100%;
    max-height: 420px;
    border-radius: 12px;
    background: #000;
    object-fit: contain;
}

.upload-page .remove-video-btn {
    position: absolute;
    top: 22px;
    right: 22px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 36px;
    padding: 8px 13px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 9px;
    background: rgba(15, 23, 42, 0.85);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: 0.2s ease;
}

.upload-page .remove-video-btn i {
    font-size: 18px;
}

.upload-page .remove-video-btn:hover {
    background: #dc2626;
}

/* ============================================
   VALIDATION ERROR
   ============================================ */

.upload-page .upload-error {
    margin: 0 0 18px;
    padding: 12px 14px;
    border: 1px solid #fecaca;
    border-radius: 10px;
    background: #fef2f2;
    color: #dc2626;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
}

.upload-page .upload-error:empty {
    display: none;
}

/* ============================================
   UPLOAD SUBMIT BUTTON
   ============================================ */

.upload-page .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 54px;
    padding: 14px 20px;
    border: none;
    border-radius: 12px;
    background: #0866ff;
    color: #fff;
    font-family: inherit;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.2px;
    cursor: pointer;
    box-shadow: 0 5px 15px rgba(8, 102, 255, 0.18);
    transition:
        background 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.upload-page .submit-btn:hover:not(:disabled) {
    background: #0054db;
    box-shadow: 0 8px 20px rgba(8, 102, 255, 0.22);
    transform: translateY(-1px);
}

.upload-page .submit-btn:active:not(:disabled) {
    transform: scale(0.99);
}

.upload-page .submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    box-shadow: none;
}

/* ============================================
   KEYBOARD ACCESSIBILITY
   ============================================ */

.upload-page button:focus-visible {
    outline: 3px solid rgba(8, 102, 255, 0.4);
    outline-offset: 3px;
}

/* ============================================
   TABLET
   ============================================ */

@media (min-width: 600px) and (max-width: 767px) {

    .upload-page {
        padding: 30px 24px 60px;
    }

    .upload-page .upload-card {
        padding: 32px;
    }

}

/* ============================================
   DESKTOP
   Existing Yunerx sidebar: 220px
   ============================================ */

@media (min-width: 768px) {

    body.page-upload {
        margin: 0;
        padding: 0 0 40px 220px;
        min-height: 100vh;
    }

    .upload-page {
        max-width: 900px;
        padding: 45px 35px 70px;
    }

    .upload-page .upload-header {
        margin-bottom: 32px;
    }

    .upload-page .upload-header h1 {
        font-size: 30px;
    }

    .upload-page .upload-card {
        padding: 45px;
        border-radius: 24px;
    }

    .upload-page .file-picker {
        min-height: 300px;
    }

    .upload-page .video-preview-box video {
        max-height: 500px;
    }

}

/* ============================================
   MOBILE
   ============================================ */

@media (max-width: 599px) {

    body.page-upload {
        padding: 0 0 100px;
        background: #fff;
    }

    .upload-page {
        max-width: 100%;
        padding: 16px 16px 35px;
    }

    .upload-page .upload-header {
        gap: 12px;
        margin-bottom: 24px;
        padding-bottom: 16px;
    }

    .upload-page .upload-header h1 {
        font-size: 22px;
    }

    .upload-page .upload-back {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        font-size: 22px;
    }

    .upload-page .upload-card {
        padding: 0;
        border: none;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
    }

    .upload-page input[type="text"] {
        height: 52px;
        margin-bottom: 24px;
        font-size: 15px;
    }

    .upload-page .type-toggle {
        gap: 10px;
        margin-bottom: 24px;
    }

    .upload-page .type-option {
        min-height: 58px;
        padding: 12px 8px;
        font-size: 13px;
        border-radius: 12px;
    }

    .upload-page .file-picker {
        min-height: 235px;
        margin-bottom: 24px;
        padding: 28px 16px;
        border-radius: 15px;
    }

    .upload-page .file-picker i {
        width: 68px;
        height: 68px;
        font-size: 38px;
        border-radius: 19px;
    }

    .upload-page .file-picker span {
        font-size: 14px;
    }

    .upload-page .video-preview-box {
        padding: 8px;
        border-radius: 14px;
    }

    .upload-page .video-preview-box video {
        max-height: 360px;
        border-radius: 9px;
    }

    .upload-page .remove-video-btn {
        top: 16px;
        right: 16px;
    }

    .upload-page .submit-btn {
        min-height: 52px;
        border-radius: 11px;
        font-size: 15px;
    }

}

/* ============================================
   VERY SMALL PHONES
   ============================================ */

@media (max-width: 360px) {

    .upload-page {
        padding-left: 12px;
        padding-right: 12px;
    }

    .upload-page .upload-header h1 {
        font-size: 20px;
    }

    .upload-page .type-option {
        font-size: 12px;
        padding: 10px 5px;
    }

    .upload-page .file-picker {
        min-height: 210px;
    }

}

/* ============================================
   REDUCED MOTION
   ============================================ */

@media (prefers-reduced-motion: reduce) {

    .upload-page *,
    .upload-page *::before,
    .upload-page *::after {
        transition: none !important;
        animation: none !important;
    }

}

</style>

</head>

<body class="page-upload">

<div class="upload-page">

    <div class="upload-header">

        <button type="button" class="upload-back" id="uploadBack" aria-label="Go back">
            <i class='bx bx-arrow-back'></i>
        </button>

        <h1>Upload Video</h1>

    </div>

    <div class="upload-card">

        <form action="/uploadvideo" method="POST" enctype="multipart/form-data" id="uploadForm">

            <input type="text" name="title" placeholder="Video Title..." required>

            <div class="type-toggle">

                <label class="type-option">
                    <input type="radio" name="type" value="long" checked>
                    <span>📹 Long Video</span>
                </label>

                <label class="type-option">
                    <input type="radio" name="type" value="short">
                    <span>⚡ Short</span>
                </label>

            </div>

            <div class="file-picker" id="videoFilePicker">

                <i class='bx bx-cloud-upload'></i>
                <span id="videoFileLabel">Choose a video file</span>

            </div>

            <input type="file" name="video" id="videoFileInput" accept="video/mp4" hidden>

            <div class="video-preview-box" id="videoPreviewBox" hidden>

                <video id="videoPreviewPlayer" muted controls playsinline></video>

                <button type="button" class="remove-video-btn" id="removeVideoBtn">
                    <i class='bx bx-x'></i>
                    Remove
                </button>

            </div>

            <p class="upload-error" id="uploadError"></p>

            <button type="submit" class="submit-btn" id="uploadSubmit">Upload</button>

        </form>

    </div>

</div>




<script src="/script.js"></script>

<script>

(function () {

    const MAX_SIZE = 100 * 1024 * 1024;   // keep in sync with the limit in routes/videos.js

    const backBtn = document.getElementById("uploadBack");
    const form = document.getElementById("uploadForm");
    const picker = document.getElementById("videoFilePicker");
    const fileInput = document.getElementById("videoFileInput");
    const fileLabel = document.getElementById("videoFileLabel");
    const previewBox = document.getElementById("videoPreviewBox");
    const previewPlayer = document.getElementById("videoPreviewPlayer");
    const removeBtn = document.getElementById("removeVideoBtn");
    const errorBox = document.getElementById("uploadError");
    const submitBtn = document.getElementById("uploadSubmit");

    let previewUrl = null;

    function showError(message) {

        errorBox.textContent = message;
        picker.classList.toggle("invalid", !!message);

    }

    function clearFile() {

        fileInput.value = "";

        if (previewUrl) {
            URL.revokeObjectURL(previewUrl);
            previewUrl = null;
        }

        previewPlayer.removeAttribute("src");
        previewPlayer.load();

        previewBox.hidden = true;
        picker.hidden = false;
        fileLabel.textContent = "Choose a video file";

    }

    backBtn.addEventListener("click", () => {

        if (history.length > 1) {
            history.back();
        } else {
            window.location.href = "/videos";
        }

    });

    picker.addEventListener("click", () => fileInput.click());

    fileInput.addEventListener("change", () => {

        const file = fileInput.files[0];

        if (!file) {
            return;
        }

        if (file.type !== "video/mp4") {
            clearFile();
            showError("Only MP4 videos are allowed.");
            return;
        }

        if (file.size > MAX_SIZE) {
            clearFile();
            showError("That video is over 100 MB. Please choose a smaller one.");
            return;
        }

        showError("");

        previewUrl = URL.createObjectURL(file);
        previewPlayer.src = previewUrl;

        previewBox.hidden = false;
        picker.hidden = true;
        fileLabel.textContent = file.name;

    });

    removeBtn.addEventListener("click", () => {

        clearFile();
        showError("");

    });

    form.addEventListener("submit", (e) => {

        if (!fileInput.files.length) {
            e.preventDefault();
            showError("Please choose a video first.");
            return;
        }

        // Stops a double tap from uploading the same video twice
        submitBtn.disabled = true;
        submitBtn.textContent = "Uploading… please wait";

    });

    // Coming back with the browser's back button should not leave the button stuck
    window.addEventListener("pageshow", () => {

        submitBtn.disabled = false;
        submitBtn.textContent = "Upload";

    });

})();

</script>

<%- include('partials/serviceworker') %>

</body>
</html>
