<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create Story</title>
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #f5f7fb;
    color: #1a1a1a;
    font-family: Arial, Helvetica, sans-serif;
}

.chat-container {
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    padding: 20px;
}

.story-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
}

.back-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: white;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.story-header h1 {
    font-size: 20px;
    font-weight: 600;
}

.story-card {
    background: white;
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.06);
}

.story-card textarea {
    width: 100%;
    min-height: 120px;
    border: 1px solid #eee;
    background: #f5f7fb;
    border-radius: 10px;
    padding: 14px;
    font-size: 15px;
    outline: none;
    resize: vertical;
    font-family: inherit;
    margin-bottom: 20px;
}

.story-card textarea:focus {
    border-color: #4169e1;
}

.story-card button {
    width: 100%;
    height: 48px;
    border: none;
    background: #4169e1;
    color: white;
    font-size: 15px;
    font-weight: 600;
    border-radius: 10px;
    cursor: pointer;
}

.story-card button:hover {
    background: #3557c7;
}

</style>

</head>
<body>

<div class="chat-container">

    <div class="story-header">
        <a href="/chats" class="back-btn">
            <i class='bx bx-arrow-back'></i>
        </a>
        <h1>Post a Story</h1>
    </div>

    <div class="story-card">

       <form
    action="/createstory"
    method="POST"
    enctype="multipart/form-data"
>

    <textarea
        name="text"
        placeholder="What's on your mind? (optional if adding a photo/video)"
    ></textarea>

    <label for="media" style="display:block; margin-bottom:12px; font-size:14px; color:#4169e1; font-weight:600; cursor:pointer;">
        <i class='bx bx-image-add'></i>
        Add photo or video (optional)
    </label>

    <input
        type="file"
        id="media"
        name="media"
        accept="image/*,video/*"
        style="margin-bottom:20px; width:100%;"
    >

    <button type="submit">Post Story</button>

</form>

    </div>

</div>

</body>
</html>
