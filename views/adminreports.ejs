<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Reported listings - Admin</title>

<style>

* { box-sizing: border-box; }

body { margin: 0; background: #f4f4f4; color: #1a1a1a; font-family: Arial, Helvetica, sans-serif; }

.wrap { max-width: 760px; margin: 0 auto; padding: 20px 16px 60px; }

.back { color: #3557c7; text-decoration: none; font-weight: 700; font-size: 14px; }

h1 { margin: 10px 0 4px; font-size: 24px; }

.sub { margin: 0 0 18px; color: #667; font-size: 14px; }

.empty { background: #fff; border-radius: 12px; padding: 40px 20px; text-align: center; color: #667; }
.empty[hidden] { display: none; }

.card { background: #fff; border-radius: 14px; padding: 14px; margin-bottom: 14px; box-shadow: 0 2px 10px rgba(0,0,0,.08); }

.row { display: flex; gap: 12px; }

.thumb { width: 84px; height: 84px; flex: none; border-radius: 10px; object-fit: cover; background: #e9edf7; display: block; }
.thumb-empty { display: flex; align-items: center; justify-content: center; color: #9aa4c4; font-size: 28px; }

.meta { min-width: 0; flex: 1; }
.meta h3 { margin: 0 0 4px; font-size: 16px; word-break: break-word; }
.meta p { margin: 3px 0; font-size: 13px; color: #556; }

.badge { display: inline-block; background: #fdecea; color: #c0392b; font-weight: 700; font-size: 12px; padding: 4px 9px; border-radius: 12px; margin: 0 6px 4px 0; }
.badge.warn { background: #fff3cd; color: #8a6d00; }

.reasons { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
.reason { background: #eef2fb; color: #3557c7; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 14px; }

.notes { list-style: none; margin: 10px 0 0; padding: 0; }
.notes li { background: #f7f8fc; border-radius: 8px; padding: 8px 10px; margin-top: 6px; font-size: 13px; color: #445; white-space: pre-wrap; word-break: break-word; }
.notes small { display: block; color: #889; margin-bottom: 2px; }

.actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }

.btn { border: none; border-radius: 10px; padding: 10px 14px; font-size: 14px; font-weight: 700; font-family: inherit; text-decoration: none; display: inline-block; cursor: pointer; }
.btn:disabled { opacity: .6; cursor: not-allowed; }
.btn-blue { background: #4169e1; color: #fff; }
.btn-light { background: #eef2fb; color: #3557c7; }
.btn-red { background: #dc2626; color: #fff; }

.msg { color: #c0392b; font-size: 13px; margin: 8px 0 0; min-height: 16px; }

</style>

</head>

<body>

<div class="wrap">

    <a href="/admin" class="back">← Admin dashboard</a>

    <h1>🚩 Reported listings</h1>

    <p class="sub"><span id="count"><%= reports.length %></span> open</p>

    <div class="empty" id="empty" <%= reports.length ? "hidden" : "" %>>
        <h3>No open reports</h3>
        <p>Everything has been reviewed.</p>
    </div>

    <div id="list">

        <% reports.forEach(function (r) { %>

            <div class="card" data-id="<%= r.productId %>">

                <div class="row">

                    <% if (r.product && r.product.images && r.product.images.length) { %>
                        <img class="thumb" src="<%= thumb(r.product.images[0].url, 200, 200) %>" alt="">
                    <% } else { %>
                        <div class="thumb thumb-empty">?</div>
                    <% } %>

                    <div class="meta">

                        <% if (r.product) { %>
                            <h3><%= r.product.title %></h3>
                            <p><%= formatPrice(r.product.price) %> · <%= r.product.category %> · <%= r.product.status %></p>
                        <% } else { %>
                            <h3>This listing was already deleted</h3>
                        <% } %>

                        <p>Seller: <b><%= r.sellerName %></b></p>

                        <p>
                            <span class="badge"><%= r.count %> <%= r.count === 1 ? "report" : "reports" %></span>
                            <% if (r.sellerTotal > r.count) { %>
                                <span class="badge warn">Seller has <%= r.sellerTotal %> open reports in total</span>
                            <% } %>
                        </p>

                        <p>Latest: <%= timeAgo(r.latest) %></p>

                    </div>

                </div>

                <div class="reasons">
                    <% r.reasons.forEach(function (entry) { %>
                        <span class="reason"><%= entry[0] %> × <%= entry[1] %></span>
                    <% }) %>
                </div>

                <% if (r.notes.length) { %>
                    <ul class="notes">
                        <% r.notes.forEach(function (note) { %>
                            <li><small><%= timeAgo(note.at) %> · <%= note.reason %></small><%= note.details %></li>
                        <% }) %>
                    </ul>
                <% } %>

                <div class="actions">

                    <% if (r.product) { %>
                        <a class="btn btn-light" href="/product/<%= r.productId %>" target="_blank" rel="noopener">View listing</a>
                    <% } %>

                    <button type="button" class="btn btn-blue" data-action="dismiss">Dismiss</button>

                    <% if (r.product) { %>
                        <button type="button" class="btn btn-red" data-action="remove">Remove listing</button>
                    <% } %>

                </div>

                <p class="msg"></p>

            </div>

        <% }) %>

    </div>

</div>

<script>

(function () {

    const count = document.getElementById("count");
    const empty = document.getElementById("empty");
    const list = document.getElementById("list");

    async function post(url) {

        const response = await fetch(url, { method: "POST", credentials: "same-origin" });

        let data = {};

        try {
            data = await response.json();
        } catch (e) {}

        return { ok: response.ok, data: data };

    }

    document.addEventListener("click", async (event) => {

        const button = event.target.closest("[data-action]");

        if (!button) {
            return;
        }

        const card = button.closest(".card");
        const id = card.dataset.id;
        const action = button.dataset.action;
        const msg = card.querySelector(".msg");

        if (action === "remove" && !confirm("Delete this listing and its photos? The seller cannot undo this.")) {
            return;
        }

        card.querySelectorAll("button").forEach((b) => { b.disabled = true; });
        msg.textContent = "";

        try {

            const result = await post("/admin/reports/" + id + "/" + action);

            if (result.ok) {

                card.remove();

                const left = list.children.length;

                count.textContent = left;
                empty.hidden = left > 0;

                return;

            }

            msg.textContent = result.data.message || "Something went wrong.";

        } catch (error) {

            msg.textContent = "Could not reach the server. Check your connection.";

        }

        card.querySelectorAll("button").forEach((b) => { b.disabled = false; });

    });

})();

</script>

</body>
</html>
