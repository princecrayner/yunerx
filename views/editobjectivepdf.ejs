<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Objective PDF</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

<div class="container">

    <h1>✏️ Edit Objective Past Question</h1>

    <form
        action="/admin/edit-objective-pdf/<%= pdf._id %>"
        method="POST"
    >

        <label>
            Title
        </label>

        <input
            type="text"
            name="title"
            value="<%= pdf.title %>"
            required
        >

        <br><br>


        <label>
            Subject
        </label>

        <input
            type="text"
            name="subject"
            value="<%= pdf.subject %>"
            required
        >

        <br><br>


        <label>
            Semester
        </label>

        <input
            type="text"
            name="semester"
            value="<%= pdf.semester %>"
            required
        >

        <br><br>


        <button
            type="submit"
            class="btn"
        >
            💾 Save Changes
        </button>

    </form>


    <br>

    <a
        href="/admin"
        class="btn"
    >
        ← Back to Admin
    </a>

</div>

</body>

</html>
