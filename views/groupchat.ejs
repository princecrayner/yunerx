<!DOCTYPE html>
<html>
<head>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Group Chat</title>

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>




<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #f5f7fb;
    color: #1a1a1a;
    font-family: Arial, Helvetica, sans-serif;
}

.chat-container {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: white;
}

.chat-container h1 {
    background: white;
    padding: 16px 18px 10px;
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    border-bottom: 1px solid #eee;
}

.chat-container > a,
.chat-container > button {
    text-decoration: none;
}

.chat-container > a button,
#leaveGroupBtn {
    margin: 10px 8px 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #eef2fb;
    border: none;
    color: #3557c7;
    font-size: 13px;
    padding: 8px 14px;
    border-radius: 20px;
    cursor: pointer;
    font-weight: 600;
}

.chat-container > a button:hover,
#leaveGroupBtn:hover {
    background: #dde6fa;
}

#leaveGroupBtn {
    color: #c0392b;
    background: #fbeceb;
    margin-left: 6px;
}

#leaveGroupBtn:hover {
    background: #f6dbd9;
}

#memberList {
    background: white;
    margin: 12px 18px 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #eee;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

#memberList h3 {
    font-size: 13px;
    color: #888;
    padding: 10px 14px;
    border-bottom: 1px solid #eee;
    font-weight: 600;
}

.member-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid #f0f0f0;
    font-size: 14px;
    color: #1a1a1a;
}

.member-row:last-child {
    border-bottom: none;
}

.member-row small {
    font-size: 11px;
    color: #3557c7;
    background: #eef2fb;
    padding: 2px 8px;
    border-radius: 10px;
    margin-left: 8px;
    font-weight: 600;
}

.remove-member-btn {
    background: none;
    border: 1px solid #f0d3d0;
    color: #c0392b;
    font-size: 12px;
    padding: 5px 10px;
    border-radius: 6px;
    cursor: pointer;
}

.remove-member-btn:hover {
    background: #fbeceb;
}

.chat-box {
    flex: 1;
    overflow-y: auto;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #f5f7fb;
}

.message {
    max-width: 75%;
    background: white;
    padding: 10px 13px;
    border-radius: 12px;
    font-size: 14px;
    align-self: flex-start;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.message strong {
    font-size: 12px;
    color: #3557c7;
    display: block;
    margin-bottom: 3px;
}

.message p {
    margin: 0;
    color: #1a1a1a;
}

.message small {
    display: block;
    font-size: 10px;
    color: #999;
    margin-top: 4px;
    text-align: right;
}

#groupForm {
    display: flex;
    gap: 10px;
    padding: 12px 16px;
    background: white;
    border-top: 1px solid #eee;
    flex-shrink: 0;
}

#groupForm input {
    flex: 1;
    height: 44px;
    border: none;
    outline: none;
    background: #f1f3f7;
    color: #1a1a1a;
    border-radius: 22px;
    padding: 0 16px;
    font-size: 14px;
}

#groupForm button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: #4169e1;
    color: white;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
}

#groupForm button:hover {
    background: #3557c7;
}

@media (min-width: 700px) {

    body {
        display: flex;
        justify-content: center;
        align-items: center;
        background: #eef1f7;
    }

    .chat-container {
        height: 90vh;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(0,0,0,0.10);
    }

}

</style>






</head>
<body>

<div class="chat-container">
<h1><%= group.groupName %></h1>

<% if (currentUser === group.admin) { %>
    <a href="/group/<%= group._id %>/addmembers">
        <button type="button">
            <i class='bx bx-user-plus'></i>
            Add Members
        </button>
    </a>
<% } %>

<button type="button" id="leaveGroupBtn">
    <i class='bx bx-log-out'></i>
    Leave Group
</button>

<!-- ↓↓↓ PASTE THE WHOLE MEMBER LIST BLOCK HERE ↓↓↓ -->
<div id="memberList">
    <h3>Members</h3>
    <% group.members.forEach(member => { %>
        <div class="member-row">
            <span><%= member %></span>
            <% if (member === group.admin) { %>
                <small>(admin)</small>
            <% } %>
            <% if (currentUser === group.admin && member !== currentUser) { %>
                <button
                    type="button"
                    class="remove-member-btn"
                    data-username="<%= member %>"
                >
                    Remove
                </button>
            <% } %>
        </div>
    <% }) %>
</div>
<!-- ↑↑↑ END OF MEMBER LIST BLOCK ↑↑↑ -->


<div class="chat-box" id="chatBox">

<% messages.forEach(msg => { %>

<div class="message">

<p>
<strong><%= msg.sender %></strong>
</p>

<p><%= msg.message %></p>

<small>
<%= msg.date %> - <%= msg.time %>
</small>

</div>

<% }) %>

</div>

<form id="groupForm">

<input
type="text"
id="messageInput"
placeholder="Type message..."
required>

<button type="submit">
<i class='bx bx-send'></i>
</button>

</form>

</div>

<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();
socket.emit("joinGroup", "<%= group._id %>");

const form = document.getElementById("groupForm");

const input = document.getElementById("messageInput");

const chatBox = document.getElementById("chatBox");

form.addEventListener("submit", (e) => {

    e.preventDefault();

    const now = new Date();

    const data = {

        groupId: "<%= group._id %>",

        sender: "<%= currentUser %>",

        message: input.value,

        date: now.toLocaleDateString(),

        time: now.toLocaleTimeString()

    };

    socket.emit("groupMessage", data);

    input.value = "";

});

socket.on("receiveGroupMessage", (data) => {

    if(data.groupId !== "<%= group._id %>"){
        return;
    }

    const div = document.createElement("div");

    div.classList.add("message");

    div.innerHTML = `

        <p><strong>${data.sender}</strong></p>

        <p>${data.message}</p>

        <small>${data.date} - ${data.time}</small>

    `;

    chatBox.appendChild(div);

    chatBox.scrollTop = chatBox.scrollHeight;

});




document.getElementById("leaveGroupBtn").addEventListener("click", async function() {

    const confirmLeave = confirm("Are you sure you want to leave this group?");

    if (!confirmLeave) {
        return;
    }

    try {

        const response = await fetch(
            "/group/<%= group._id %>/leave",
            { method: "POST" }
        );

        const result = await response.json();

        if (result.success) {
            window.location.href = "/chats";
        } else {
            alert(result.message || "Unable to leave group.");
        }

    } catch (error) {

        console.error("Leave group error:", error);
        alert("Something went wrong.");

    }

});



document.querySelectorAll(".remove-member-btn").forEach(function(button) {

    button.addEventListener("click", async function() {

        const username = button.getAttribute("data-username");

        const confirmRemove = confirm("Remove " + username + " from the group?");

        if (!confirmRemove) {
            return;
        }

        try {

            const response = await fetch(
                "/group/<%= group._id %>/removemember",
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ username })
                }
            );

            const result = await response.json();

            if (result.success) {
                button.closest(".member-row").remove();
            } else {
                alert(result.message || "Unable to remove member.");
            }

        } catch (error) {

            console.error("Remove member error:", error);
            alert("Something went wrong.");

        }

    });

});



</script>

</body>
</html>
