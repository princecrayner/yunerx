<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Story Privacy</title>
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #f5f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1a1a1a;
}

.privacy-page {
    max-width: 500px;
    margin: 0 auto;
    padding-bottom: 40px;
}

.privacy-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.back-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #f1f3f5;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 20px;
}

.privacy-header h1 {
    font-size: 17px;
    font-weight: 600;
}

.privacy-tabs {
    display: flex;
    background: white;
    border-bottom: 1px solid #eee;
}

.privacy-tab {
    flex: 1;
    padding: 14px;
    border: none;
    background: none;
    font-size: 13px;
    font-weight: 600;
    color: #888;
    cursor: pointer;
    border-bottom: 3px solid transparent;
}

.privacy-tab.active {
    color: #4169e1;
    border-bottom-color: #4169e1;
}

.privacy-section {
    display: none;
    padding: 16px;
}

.privacy-section.active {
    display: block;
}

.privacy-note {
    font-size: 13px;
    color: #777;
    margin-bottom: 16px;
    line-height: 1.5;
}

.contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: white;
    padding: 14px;
    border-radius: 12px;
    margin-bottom: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.contact-info {
    display: flex;
    align-items: center;
    gap: 10px;
}

.contact-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #eef2fb;
    color: #4169e1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
}

.contact-name {
    font-size: 14px;
    font-weight: 600;
}

.toggle-btn {
    padding: 7px 14px;
    border-radius: 16px;
    border: none;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
}

.toggle-btn.off {
    background: #eef2fb;
    color: #4169e1;
}

.toggle-btn.on {
    background: #fbeceb;
    color: #c0392b;
}

.empty-list {
    text-align: center;
    color: #999;
    padding: 30px 0;
    font-size: 14px;
}

</style>

</head>
<body>

<div class="privacy-page">

    <div class="privacy-header">
        <a href="/chats" class="back-btn">
            <i class='bx bx-arrow-back'></i>
        </a>
        <h1>Story Privacy</h1>
    </div>

    <div class="privacy-tabs">
        <button type="button" class="privacy-tab active" id="hideFromTab">Hide My Story</button>
        <button type="button" class="privacy-tab" id="muteTab">Hide Their Story</button>
    </div>

    <!-- HIDE MY STORY FROM -->
    <div class="privacy-section active" id="hideFromSection">

        <p class="privacy-note">Choose contacts who won't be able to see your story.</p>

        <% if (contacts.length === 0) { %>

            <div class="empty-list">No contacts yet.</div>

        <% } else { %>

            <% contacts.forEach(contact => { %>

                <% const isHidden = hiddenStoryFrom.includes(contact); %>

                <div class="contact-row">

                    <div class="contact-info">
                        <div class="contact-avatar"><i class='bx bx-user'></i></div>
                        <div class="contact-name"><%= contact %></div>
                    </div>

                    <button
                        type="button"
                        class="toggle-btn hide-from-btn <%= isHidden ? 'on' : 'off' %>"
                        data-username="<%= contact %>"
                    >
                        <%= isHidden ? "Hidden" : "Visible" %>
                    </button>

                </div>

            <% }) %>

        <% } %>

    </div>

    <!-- MUTE OTHERS' STORIES -->
    <div class="privacy-section" id="muteSection">

        <p class="privacy-note">Hide specific contacts' stories from your own feed. You can unhide them anytime.</p>

        <% if (contacts.length === 0) { %>

            <div class="empty-list">No contacts yet.</div>

        <% } else { %>

            <% contacts.forEach(contact => { %>

                <% const isMuted = mutedStoryUsers.includes(contact); %>

                <div class="contact-row">

                    <div class="contact-info">
                        <div class="contact-avatar"><i class='bx bx-user'></i></div>
                        <div class="contact-name"><%= contact %></div>
                    </div>

                    <button
                        type="button"
                        class="toggle-btn mute-btn <%= isMuted ? 'on' : 'off' %>"
                        data-username="<%= contact %>"
                    >
                        <%= isMuted ? "Hidden" : "Visible" %>
                    </button>

                </div>

            <% }) %>

        <% } %>

    </div>

</div>

<script>

const hideFromTab = document.getElementById("hideFromTab");
const muteTab = document.getElementById("muteTab");
const hideFromSection = document.getElementById("hideFromSection");
const muteSection = document.getElementById("muteSection");

hideFromTab.addEventListener("click", () => {
    hideFromTab.classList.add("active");
    muteTab.classList.remove("active");
    hideFromSection.classList.add("active");
    muteSection.classList.remove("active");
});

muteTab.addEventListener("click", () => {
    muteTab.classList.add("active");
    hideFromTab.classList.remove("active");
    muteSection.classList.add("active");
    hideFromSection.classList.remove("active");
});

document.querySelectorAll(".hide-from-btn").forEach(btn => {

    btn.addEventListener("click", async () => {

        const username = btn.getAttribute("data-username");

        try {

            const response = await fetch(`/story-privacy/hide-from/${username}`, {
                method: "POST"
            });

            const result = await response.json();

            if (result.success) {

                btn.textContent = result.hidden ? "Hidden" : "Visible";
                btn.classList.toggle("on", result.hidden);
                btn.classList.toggle("off", !result.hidden);

            }

        } catch (error) {

            console.error("Toggle hide-from error:", error);

        }

    });

});

document.querySelectorAll(".mute-btn").forEach(btn => {

    btn.addEventListener("click", async () => {

        const username = btn.getAttribute("data-username");

        try {

            const response = await fetch(`/story-privacy/mute/${username}`, {
                method: "POST"
            });

            const result = await response.json();

            if (result.success) {

                btn.textContent = result.muted ? "Hidden" : "Visible";
                btn.classList.toggle("on", result.muted);
                btn.classList.toggle("off", !result.muted);

            }

        } catch (error) {

            console.error("Toggle mute error:", error);

        }

    });

});

</script>

</body>
</html>
