<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= semester %> - Past Theory Questions
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
    
     <link
        href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
        rel="stylesheet"
    >
    
    
     <style>
        .back-btn {

            display: inline-block;

            margin-bottom: 20px;

            text-decoration: none;

            color: royalblue;

        }
    </style>

</head>


<body>


<div class="container">


   <a
    href="javascript:history.back()"
    class="back-btn"
>

        <i class="bx bx-arrow-back"></i>

        Back to Semesters

    </a>
    

    <h1>
        📖 Past Theory Questions
    </h1>


    <h2>
        <%= semester %>
    </h2>


    <p>
        Select a subject to view available past questions.
    </p>

</div>



<div class="container">

    <% if (subjects.length === 0) { %>

        <p>
            No theory past questions available
            for this semester.
        </p>

    <% } %>



    <% subjects.forEach(subject => { %>

        <a href="/theory-pdfs/level/<%= encodeURIComponent(level) %>/semester/<%= encodeURIComponent(semester) %>/subject/<%= encodeURIComponent(subject) %>" class="btn">

            📚 <%= subject %>

        </a>

    <% }) %>

</div>


</body>

</html>
