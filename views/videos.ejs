<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Videos</title>


<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>

body{
    background:#111;
    color:white;
    font-family:Arial;
    margin:0;
    padding-bottom:100px;
}

.upload-btn {
   position: absolute;
   top: 15px;
   right: 15px;

   width: 40px;
   height: 40px;

   padding: 0;
   background: #555;
   border-radius: 50%;
   cursor:pointer;

   display: flex;
   align-items: center;
   justify-content: center;
}
.upload-btn i {
  font-size: 28px;
}

.video-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:20px;
    padding:20px;
}

.video-card{
    background:#222;
    padding:10px;
    border-radius:10px;
}

video{
    width:100%;
    aspect-ratio:16/9;
    object-fit:cover;
    border-radius:10px;
}

.upload-container {
    position: fixed;
    left: 0;
    bottom: 0;

    width: 100%;
    height: 70%;
    border-radius: 15px 15px 0 0;

    background: #333;
    box-sizing: border-box;
    padding: 50px;
    padding-bottom: none;

    transform: translateY(100%);
    transition: transform 0.3s ease;

    z-index: 3000;
}

.upload-container.active {
    transform: translateY(0);
}

input{
    width:100%;
    padding:12px;
    margin-bottom:15px;
    box-sizing: border-box;
}



button{
    width:100%;
    padding:12px;
    border:none;
    background:red;
    color:white;
    font-size:18px;
    cursor:pointer;
}

.footer{
    position:fixed;
    bottom:0;
    left:0;
    width:100%;
    background:#000;
    display:flex;
    justify-content:space-around;
    padding:15px 0;
}

.footer-icon{
    color:white;
    font-size:28px;
    cursor:pointer;
}

.close-upload {
    position: absolute;
    top: 15px;
    right: 15px;

    width: 40px;
    height: 40px;

    padding: 0;

    background: #555;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;
}

.close-upload i {
    font-size: 28px;
}


.type-toggle {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
}

.type-option {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    background: #444;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
}

.type-option input {
    display: none;
}

.type-option:has(input:checked) {
    background: red;
    font-weight: bold;
}


.shorts-row {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 15px 20px;
    scrollbar-width: none;
}

.shorts-row::-webkit-scrollbar {
    display: none;
}

.short-card {
    flex: 0 0 140px;
    background: #222;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: white;
}

.short-card video {
    width: 140px;
    height: 220px;
    object-fit: cover;
    border-radius: 12px 12px 0 0;
    aspect-ratio: unset;
}

.short-card p {
    padding: 8px;
    font-size: 12px;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.video-card {
    text-decoration: none;
    color: white;
    display: block;
}

.feed-loading {
    display: none;
    justify-content: center;
    padding: 30px;
}

.loading-spinner {
    width: 30px;
    height: 30px;
    border: 3px solid #444;
    border-top: 3px solid red;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}


.file-picker {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 30px 15px;
    border: 2px dashed #555;
    border-radius: 10px;
    margin-bottom: 15px;
    cursor: pointer;
    color: #ccc;
    text-align: center;
    transition: 0.2s ease;
}

.file-picker:hover {
    border-color: red;
    color: white;
}

.file-picker i {
    font-size: 32px;
}

.file-picker span {
    font-size: 14px;
}

.video-preview-box {
    position: relative;
    margin-bottom: 15px;
}

.video-preview-box video {
    width: 100%;
    border-radius: 10px;
    max-height: 300px;
    background: black;
}

.remove-video-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: auto;
    padding: 6px 12px;
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(0,0,0,0.7);
    font-size: 13px;
    border-radius: 20px;
}

</style>

</head>
<body>

  
  <div class="upload-container" id="uploadContainer">
  
  <button type="button" class="close-upload" id="closeUpload">
    <i class='bx bx-x'></i>
</button>

<h1>Upload Video</h1>

<form action="/uploadvideo" method="POST" enctype="multipart/form-data">

<input type="text" name="title" placeholder="Video Title" required>

<div class="type-toggle">

    <label class="type-option">
        <input type="radio" name="type" value="long" checked>
        <span>📹 Long Video</span>
    </label>

    <label class="type-option">
        <input type="radio" name="type" value="short">
        <span>⚡ Short</span>
    </label>

</div>

<div class="file-picker" id="videoFilePicker">

    <i class='bx bx-cloud-upload'></i>
    <span id="videoFileLabel">Choose a video file</span>

</div>

<input
    type="file"
    name="video"
    id="videoFileInput"
    accept="video/mp4"
    required
    style="display:none;"
>

<div class="video-preview-box" id="videoPreviewBox" style="display:none;">

    <video id="videoPreviewPlayer" muted controls></video>

    <button type="button" class="remove-video-btn" id="removeVideoBtn">
        <i class='bx bx-x'></i>
        Remove
    </button>

</div>

<button type="submit">Upload</button>
</form>

</div>
  
  
  
  
    <!-- UPLOAD -->
    <div class="upload-btn" id="uploadBtn">
      <i class='bx bx-plus'></i>
    </div>


<!-- =========================
     FEED (long videos + shorts, repeating, infinite scroll)
========================= -->

<div id="feedContainer">

    <% if (!hasContent) { %>

        <p style="padding:40px 20px; color:#888; text-align:center;">No videos yet,be the first.</p>

    <% } else { %>

        <div class="feed-block">

            <% if (longVideos.length > 0) { %>

                <h1 style="padding-left:20px;">Videos</h1>

                <div class="video-grid">

                    <% longVideos.forEach(video => { %>

                        <a href="/watch/<%= video._id %>" class="video-card">
                            <video muted>
                                <source src="<%= video.videoUrl %>">
                            </video>
                            <p><%= video.title %></p>
                        </a>

                    <% }) %>

                </div>

            <% } %>

            <% if (shorts.length > 0) { %>

                <h1 style="padding-left:20px;">Shorts</h1>

                <div class="shorts-row">

                    <% shorts.forEach(video => { %>

                        <a href="/shorts/<%= video._id %>" class="short-card">
                            <video muted>
                                <source src="<%= video.videoUrl %>">
                            </video>
                            <p><%= video.title %></p>
                        </a>

                    <% }) %>

                </div>

            <% } %>

        </div>

    <% } %>

</div>

<div id="feedLoading" class="feed-loading">
    <div class="loading-spinner"></div>
</div>

<div id="feedSentinel"></div>


<script src="/script.js"></script>


<script>

const uploadBtn = document.getElementById("uploadBtn");
const uploadContainer = document.getElementById("uploadContainer");

const closeUpload = document.getElementById("closeUpload");

if (uploadBtn && uploadContainer) {

    uploadBtn.addEventListener("click", () => {

        uploadContainer.classList.add("active");

    });

}


if (closeUpload && uploadContainer) {

    closeUpload.addEventListener("click", () => {

        uploadContainer.classList.remove("active");

    });

}


// =========================
// INFINITE SCROLL FEED
// =========================

let currentOffset = <%- nextOffset %>;
let isLoading = false;
let feedHasContent = <%- hasContent %>;

const feedContainer = document.getElementById("feedContainer");
const feedLoading = document.getElementById("feedLoading");
const feedSentinel = document.getElementById("feedSentinel");

function buildLongVideoHtml(video) {

    return `
        <a href="/watch/${video._id}" class="video-card">
            <video muted>
                <source src="${video.videoUrl}">
            </video>
            <p>${video.title}</p>
        </a>
    `;

}

function buildShortHtml(video) {

    return `
        <a href="/shorts/${video._id}" class="short-card">
            <video muted>
                <source src="${video.videoUrl}">
            </video>
            <p>${video.title}</p>
        </a>
    `;

}

async function loadNextBlock() {

    if (isLoading || !feedHasContent) {
        return;
    }

    isLoading = true;
    feedLoading.style.display = "flex";

    try {

        const response = await fetch(`/videos/feed?offset=${currentOffset}`);

        if (!response.ok) {
            throw new Error("Feed request failed");
        }

        const data = await response.json();

        if (!data.hasContent) {
            feedHasContent = false;
            return;
        }

        const block = document.createElement("div");
        block.className = "feed-block";

        if (data.longVideos.length > 0) {

            const heading = document.createElement("h1");
            heading.style.paddingLeft = "20px";
            heading.textContent = "Videos";
            block.appendChild(heading);

            const videoGrid = document.createElement("div");
            videoGrid.className = "video-grid";
            videoGrid.innerHTML = data.longVideos.map(buildLongVideoHtml).join("");
            block.appendChild(videoGrid);

        }

        if (data.shorts.length > 0) {

            const heading = document.createElement("h1");
            heading.style.paddingLeft = "20px";
            heading.textContent = "Shorts";
            block.appendChild(heading);

            const shortsRow = document.createElement("div");
            shortsRow.className = "shorts-row";
            shortsRow.innerHTML = data.shorts.map(buildShortHtml).join("");
            block.appendChild(shortsRow);

        }

        feedContainer.appendChild(block);

        currentOffset = data.nextOffset;

    } catch (error) {

        console.error("Error loading more videos:", error);

    } finally {

        isLoading = false;
        feedLoading.style.display = "none";

    }

}

const observer = new IntersectionObserver((entries) => {

    entries.forEach((entry) => {

        if (entry.isIntersecting) {
            loadNextBlock();
        }

    });

}, {
    rootMargin: "400px"
});

observer.observe(feedSentinel);



const videoFilePicker = document.getElementById("videoFilePicker");
const videoFileInput = document.getElementById("videoFileInput");
const videoFileLabel = document.getElementById("videoFileLabel");
const videoPreviewBox = document.getElementById("videoPreviewBox");
const videoPreviewPlayer = document.getElementById("videoPreviewPlayer");
const removeVideoBtn = document.getElementById("removeVideoBtn");

videoFilePicker.addEventListener("click", () => {
    videoFileInput.click();
});

videoFileInput.addEventListener("change", () => {

    const file = videoFileInput.files[0];

    if (!file) {
        return;
    }

    const videoUrl = URL.createObjectURL(file);

    videoPreviewPlayer.src = videoUrl;
    videoPreviewBox.style.display = "block";
    videoFilePicker.style.display = "none";

    videoFileLabel.textContent = file.name;

});

removeVideoBtn.addEventListener("click", () => {

    videoFileInput.value = "";
    videoPreviewPlayer.src = "";
    videoPreviewBox.style.display = "none";
    videoFilePicker.style.display = "flex";
    videoFileLabel.textContent = "Choose a video file";

});


</script>


<%- include('partials/serviceworker') %>

</body>
</html>
