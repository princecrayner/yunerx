<!DOCTYPE html>
<html>

<head>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Profile</title>

<link rel="stylesheet" href="/css/profile.css">

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>

body{
    background:#111;
    color:white;
    font-family:Arial;
    margin: 0;
    padding: 0;
}

.profile-header{
    text-align:center;
    padding:20px;
}

/* PROFILE IMAGE */

.profile-image-container{

    width: 50px;
    height: 50px;
    position: relative;
    justify-content: center;
    align-items: center;
}


/* REAL IMAGE */

.profile-image{
    width:120px;
    height:120px;
    border-radius:50%;
    object-fit:cover;
    border:4px solid royalblue;
}

.profile-header img{
    width:120px;
    height:120px;
    border-radius:50%;
    object-fit:cover;
}

/* NAV ITEMS */
.nav-item {
  position: fixed;
  top: 20px;
  right: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 70px;
  height: 20px;
}

.nav-item i {
  color: white;
  font-size: 30px;
}


/* SIDEBAR */
.sidebar{
    position: fixed;
    top: 0;
    left: -300px;
    width: 300px;
    height: 100%;
    background: #333;
    color: white;
    padding-top: 60px;
    transition: 0.3s;
    z-index: 3000;
}

.sidebar a{
    display: block;
    padding: 15px;
    color: white;
    text-decoration: none;
    text-align: center;
}

.sidebar p{
    color: white;
    position: fixed;
    bottom: 20px;
    text-align: center;
    font-size: 14px;
    font-style: italic;
    margin-left: 85px;
}


.sidebar a:hover{
    background: #575757;
}

.sidebar.active{
    left: 0;
}


/* OVERLAY */
.overlay{
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    z-index: 2000;
}

.overlay.active{
    display: block;
}


.video-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:20px;
    padding:20px;
}

.video-card{
    background:#222;
    padding:10px;
    border-radius:10px;
}

video{
    width:100%;
    aspect-ratio:16/9;
    border-radius:10px;
}

.profile-info{
    text-align:center;
    margin-top:10px;
    border-bottom: 1px solid white;
}


</style>


</head>

<body>
  
<div class="nav-item">
     
    <!-- HOME -->
    <a href="/">
        <i class='bx bx-home-alt'></i>
    </a>

    <!-- MENU -->
    <div class="menu-icon" id="menuBtn"> 
       <i class='bx bx-menu'></i>
    </div>
</div>


<!-- Sidebar -->
<div class="sidebar" id="sidebar">

    <a href="/settings">Settings</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a href="/logout">Logout</a>

    <div class="copyrighttext">

        <p>© 2026 Yunerx</p>

    </div>

</div>

<!-- Overlay -->
<div class="overlay" id="overlay"></div>



<div class="profile-header">


        <!-- DEFAULT ICON -->
<div class="profile-header">

    <% if(user && user.profileImage){ %>

        <img
            src="<%= user.profileImage %>"
            class="profile-image"
        >

    <% } else { %>

        <div class="default-user-icon">

            <i class='bx bx-user'></i>

        </div>

    <% } %>

</div>


    <!-- USER INFO -->
    <div class="profile-info">

        <h1><%= user.username %></h1>

        <p><%= user.email %></p>

        <p><%= user.phone %></p>

    </div>

</div>




<h2 style="padding-left:20px;">Your Videos</h2>


<div class="video-grid">

<% videos.forEach(video => { %>

<div class="video-card">

<video controls>

<source src="<%= video.videoUrl %>">

</video>

<p><%= video.title %></p>

</div>

<% }) %>

</div>


<script src="/script.js"></script>

</body>
</html>
