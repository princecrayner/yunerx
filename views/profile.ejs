<!DOCTYPE html>
<html>

<head>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Profile</title>

<link rel="stylesheet" href="/css/profile.css">

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>

body{
    background:#111;
    color:white;
    font-family:Arial;
    margin: 0;
    padding: 0;
}

.profile-header{
    text-align:center;
    padding:20px;
}

/* PROFILE IMAGE */

.profile-image-container{

    width: 50px;
    height: 50px;
    position: relative;
    justify-content: center;
    align-items: center;
}


/* REAL IMAGE */

.profile-image{
    width:120px;
    height:120px;
    border-radius:50%;
    object-fit:cover;
    border:4px solid royalblue;
}

.profile-header img{
    width:120px;
    height:120px;
    border-radius:50%;
    object-fit:cover;
}

/* NAV ITEMS */
.nav-item {
  position: fixed;
  top: 20px;
  right: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 70px;
  height: 20px;
}

.nav-item i {
  color: white;
  font-size: 30px;
}


/* SIDEBAR */
.sidebar{
    position: fixed;
    top: 0;
    left: -300px;
    width: 300px;
    height: 100%;
    background: #333;
    color: white;
    padding-top: 60px;
    transition: 0.3s;
    z-index: 3000;
}

.sidebar a{
    display: block;
    padding: 15px;
    color: white;
    text-decoration: none;
    text-align: center;
}

.sidebar p{
    color: white;
    position: fixed;
    bottom: 20px;
    text-align: center;
    font-size: 14px;
    font-style: italic;
    margin-left: 85px;
}


.sidebar a:hover{
    background: #575757;
}

.sidebar.active{
    left: 0;
}


/* OVERLAY */
.overlay{
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    z-index: 2000;
}

.overlay.active{
    display: block;
}


.video-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:20px;
    padding:20px;
}

.video-card{
    background:#222;
    padding:10px;
    border-radius:10px;
}

video{
    width:100%;
    aspect-ratio:16/9;
    border-radius:10px;
}

.profile-info{
    text-align:center;
    margin-top:10px;
    border-bottom: 1px solid white;
}



.profile-tabs {
    display: flex;
    border-bottom: 1px solid #333;
    margin: 10px 0;
}

.tab-btn {
    flex: 1;
    background: none;
    border: none;
    color: #888;
    padding: 14px;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    border-bottom: 3px solid transparent;
}

.tab-btn.active {
    color: white;
    border-bottom-color: royalblue;
}

.tab-panel {
    display: none;
}

.tab-panel.active {
    display: block;
}

.empty-tab-message {
    padding: 20px;
    color: #888;
    text-align: center;
}

/* LONG VIDEOS — YouTube-style: wide 16:9 thumbnails, single/two column */
.video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    padding: 16px 20px;
}

.video-card {
    text-decoration: none;
    color: white;
    display: block;
    background: #222;
    border-radius: 10px;
    overflow: hidden;
}

.video-card video {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
}

.video-card p {
    padding: 10px;
    margin: 0;
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* SHORTS — TikTok-style: tall 9:16 grid, 3 columns like a real shorts shelf */
.shorts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 16px 20px;
}

.short-grid-card {
    text-decoration: none;
    color: white;
    display: block;
    background: #222;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
}

.short-grid-card video {
    width: 100%;
    aspect-ratio: 9/16;
    object-fit: cover;
    display: block;
}

.short-grid-card p {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 6px 8px;
    margin: 0;
    font-size: 11px;
    background: linear-gradient(transparent, rgba(0,0,0,0.8));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

@media (max-width: 500px) {

    .shorts-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
        padding: 12px;
    }

    .video-grid {
        grid-template-columns: 1fr;
        padding: 12px;
    }

}



.video-card-wrapper,
.short-card-wrapper {
    position: relative;
}

.delete-video-form {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 5;
}

.short-delete-form {
    top: 6px;
    right: 6px;
}

.delete-video-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: rgba(0,0,0,0.6);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 15px;
}

.delete-video-btn:hover {
    background: #dc2626;
}


</style>


</head>

<body>
  
<div class="nav-item">
     
    <!-- HOME -->
    <a href="/">
        <i class='bx bx-home-alt'></i>
    </a>

    <!-- MENU -->
    <div class="menu-icon" id="menuBtn"> 
       <i class='bx bx-menu'></i>
    </div>
</div>


<!-- Sidebar -->
<div class="sidebar" id="sidebar">

    <a href="/settings">Settings</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a href="/logout">Logout</a>

    <div class="copyrighttext">

        <p>© 2026 Yunerx</p>

    </div>

</div>

<!-- Overlay -->
<div class="overlay" id="overlay"></div>



<div class="profile-header">


        <!-- DEFAULT ICON -->
<div class="profile-header">

    <% if(user && user.profileImage){ %>

        <img
            src="<%= user.profileImage %>"
            class="profile-image"
        >

    <% } else { %>

        <div class="default-user-icon">

            <i class='bx bx-user'></i>

        </div>

    <% } %>

</div>


    <!-- USER INFO -->
    <div class="profile-info">

        <h1><%= user.username %></h1>

        <p><%= user.email %></p>

        <p><%= user.phone %></p>

    </div>

</div>




<!-- =========================
     TAB SWITCHER
========================= -->

<div class="profile-tabs">

    <button type="button" class="tab-btn active" id="videosTab">
        <i class='bx bx-play-circle'></i>
        Videos
    </button>

    <button type="button" class="tab-btn" id="shortsTab">
        <i class='bx bx-video'></i>
        Shorts
    </button>

</div>


<!-- =========================
     LONG VIDEOS GRID
========================= -->

<div class="tab-panel active" id="videosPanel">

    <div class="video-grid">

        <% if (longVideos.length === 0) { %>

            <p class="empty-tab-message">No videos uploaded yet.</p>

        <% } %>

        <% longVideos.forEach(video => { %>

<div class="video-card-wrapper">

    <a href="/watch/<%= video._id %>" class="video-card">

        <video muted>
            <source src="<%= video.videoUrl %>">
        </video>

        <p><%= video.title %></p>

    </a>

    <form action="/video/<%= video._id %>/delete" method="POST" class="delete-video-form" onsubmit="return confirm('Delete this video? This cannot be undone.');">
        <button type="submit" class="delete-video-btn">
            <i class='bx bx-trash'></i>
        </button>
    </form>

</div>

<% }) %>

    </div>

</div>


<!-- =========================
     SHORTS GRID
========================= -->

<div class="tab-panel" id="shortsPanel">

    <div class="shorts-grid">

        <% if (shorts.length === 0) { %>

            <p class="empty-tab-message">No shorts uploaded yet.</p>

        <% } %>

        <% shorts.forEach(video => { %>

    <div class="short-card-wrapper">

        <a href="/shorts/<%= video._id %>" class="short-grid-card">

            <video muted>
                <source src="<%= video.videoUrl %>">
            </video>

            <p><%= video.title %></p>

        </a>

        <form action="/video/<%= video._id %>/delete" method="POST" class="delete-video-form short-delete-form" onsubmit="return confirm('Delete this short? This cannot be undone.');">
            <button type="submit" class="delete-video-btn">
                <i class='bx bx-trash'></i>
            </button>
        </form>

    </div>

<% }) %>

    </div>

</div>



<script>

const videosTab = document.getElementById("videosTab");
const shortsTab = document.getElementById("shortsTab");
const videosPanel = document.getElementById("videosPanel");
const shortsPanel = document.getElementById("shortsPanel");

videosTab.addEventListener("click", () => {

    videosTab.classList.add("active");
    shortsTab.classList.remove("active");

    videosPanel.classList.add("active");
    shortsPanel.classList.remove("active");

});

shortsTab.addEventListener("click", () => {

    shortsTab.classList.add("active");
    videosTab.classList.remove("active");

    shortsPanel.classList.add("active");
    videosPanel.classList.remove("active");

});

</script>


<script src="/script.js"></script>

<%- include('partials/serviceworker') %>

</body>
</html>
