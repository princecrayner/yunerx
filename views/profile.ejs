<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Profile - Yunerx</title>

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<%- include('partials/market-styles') %>

<style>

/* ---------- side menu (opened by the button at the top right) ---------- */

.menu-fab {
    position: fixed; top: 12px; right: 14px; z-index: 1001;
    width: 42px; height: 42px; border: none; border-radius: 50%;
    background: #fff; color: #1a1a1a; font-size: 26px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; box-shadow: 0 2px 10px rgba(0,0,0,.15);
}

.sidebar {
    position: fixed; top: 0; left: -300px; width: 300px; max-width: 85vw; height: 100%;
    background: #333; color: #fff; padding-top: 60px; transition: 0.3s; z-index: 3000;
}

.sidebar.active { left: 0; }

.sidebar a { display: block; padding: 15px; color: #fff; text-decoration: none; text-align: center; }
.sidebar a:hover { background: #575757; }

.sidebar-copy { position: absolute; bottom: 20px; width: 100%; text-align: center; font-size: 14px; font-style: italic; color: #bbb; }

.overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: none; z-index: 2000; }
.overlay.active { display: block; }

/* ---------- profile card ---------- */

.page-profile .mk-head { padding-right: 56px; }

.prof-card {
    max-width: 640px; margin: 0 auto; background: #fff; border-radius: 18px;
    padding: 20px 16px; text-align: center; box-shadow: 0 3px 15px rgba(0,0,0,.06);
}

.prof-avatar { width: 96px; height: 96px; font-size: 84px; margin: 0 auto 10px; border: 3px solid #4169e1; }

.prof-card h2 { margin: 0; font-size: 22px; word-break: break-word; }
.prof-card .private { margin: 4px 0 0; color: #778; font-size: 13px; word-break: break-word; }

.stats { display: flex; justify-content: center; margin: 16px 0; }
.stat { flex: 1; max-width: 120px; }
.stat b { display: block; font-size: 20px; color: #3557c7; }
.stat span { font-size: 12px; color: #778; }

.prof-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

/* ---------- tabs ---------- */

.ptabs {
    display: flex; gap: 8px; max-width: 640px; margin: 18px auto 14px;
    background: #e4e9f5; padding: 5px; border-radius: 14px;
}

.ptab {
    flex: 1; border: none; background: transparent; padding: 11px 8px; border-radius: 10px;
    font-size: 14px; font-weight: 700; color: #667; cursor: pointer; font-family: inherit;
}

.ptab.active { background: #fff; color: #3557c7; box-shadow: 0 2px 8px rgba(0,0,0,.08); }

.panel { display: none; }
.panel.active { display: block; }

/* ---------- your items ---------- */

.own-item { display: flex; flex-direction: column; gap: 8px; }
.own-actions { display: flex; gap: 8px; }
.own-actions .mk-btn { padding: 10px 12px; font-size: 13px; }
.own-actions .own-status { flex: 1; }
.own-actions .own-del { width: 46px; flex: none; font-size: 18px; }

.own-msg { max-width: 640px; margin: 10px auto 0; text-align: center; color: #c0392b; font-size: 13px; min-height: 16px; }

.p-empty { text-align: center; padding: 40px 20px; color: #778; }
.p-empty i { font-size: 52px; color: #9aa4c4; display: block; margin-bottom: 8px; }
.p-empty h3 { margin: 0 0 6px; color: #1a1a1a; }
.p-empty p { margin: 0 0 16px; font-size: 14px; }

@media (min-width: 768px) {

    .page-profile .mk-head { display: none; }      /* the top bar already says "Profile" */

    .menu-fab { top: 11px; }

}

.own-actions .own-edit { width: 46px; flex: none; font-size: 18px; padding: 10px 0; }

</style>

</head>

<body class="page-market page-profile">

<header class="page-top">
    <h1>Profile</h1>
</header>

<button type="button" class="menu-fab" id="menuBtn" aria-label="Menu"><i class='bx bx-menu'></i></button>

<div class="sidebar" id="sidebar">

    <a href="/settings">Settings</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a href="/logout">Logout</a>

    <div class="sidebar-copy">© 2026 Yunerx</div>

</div>

<div class="overlay" id="overlay"></div>


<main class="mk">

    <div class="mk-head">
        <h1>Profile</h1>
    </div>

    <section class="prof-card">

        <div class="avatar prof-avatar">
            <i class='bx bxs-user-circle'></i>
            <% if (user.profileImage) { %>
                <img src="<%= user.profileImage %>" alt="" onerror="this.remove()">
            <% } %>
        </div>

        <h2><%= user.username %></h2>

        <p class="private"><%= user.email %></p>
        <p class="private"><%= user.phone %></p>

        <div class="stats">
            <div class="stat"><b><%= forSale.length %></b><span>For sale</span></div>
            <div class="stat"><b><%= soldCount %></b><span>Sold</span></div>
            <div class="stat"><b><%= totalViews %></b><span>Views</span></div>
        </div>

        <div class="prof-actions">
            <a href="/sell" class="mk-btn mk-btn-blue"><i class='bx bx-plus'></i> Sell an item</a>
            <a href="/settings" class="mk-btn mk-btn-light"><i class='bx bx-cog'></i> Settings</a>
            <a href="/saved" class="mk-btn mk-btn-light"><i class='bx bx-heart'></i> Saved</a>
        </div>

    </section>

    <p class="own-msg" id="ownMsg"></p>

    <div class="ptabs">
        <button type="button" class="ptab active" data-tab="forsale">For sale (<%= forSale.length %>)</button>
        <button type="button" class="ptab" data-tab="sold">Sold (<%= soldCount %>)</button>
    </div>


    <!-- FOR SALE -->
    <section class="panel active" id="panel-forsale">

        <% if (forSale.length === 0) { %>

            <div class="p-empty">
                <i class='bx bx-store'></i>
                <h3>Nothing for sale yet</h3>
                <p>Post your first item. It only takes a minute.</p>
                <a href="/sell" class="mk-btn mk-btn-blue"><i class='bx bx-plus'></i> Sell an item</a>
            </div>

        <% } else { %>

            <div class="pgrid">

                <% forSale.forEach(function (p) { %>

                    <div class="own-item">

                        <%- include('partials/product-card', { p: p }) %>

                        <div class="own-actions">

                            <button type="button" class="mk-btn mk-btn-light own-status" data-id="<%= p._id %>" data-next="sold">
                                <i class='bx bx-check-circle'></i> Mark sold
                            </button>

                            <a href="/product/<%= p._id %>/edit" class="mk-btn mk-btn-light own-edit" aria-label="Edit listing">
                                <i class='bx bx-edit'></i>
                            </a>

                            <button type="button" class="mk-btn mk-btn-red own-del" data-id="<%= p._id %>" aria-label="Delete listing">
                                <i class='bx bx-trash'></i>
                            </button>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </section>


    <!-- SOLD -->
    <section class="panel" id="panel-sold">

        <% if (sold.length === 0) { %>

            <div class="p-empty">
                <i class='bx bx-check-circle'></i>
                <h3>Nothing sold yet</h3>
                <p>Items you mark as sold show up here.</p>
            </div>

        <% } else { %>

            <div class="pgrid">

                <% sold.forEach(function (p) { %>

                    <div class="own-item">

                        <%- include('partials/product-card', { p: p }) %>

                        <div class="own-actions">

                            <button type="button" class="mk-btn mk-btn-light own-status" data-id="<%= p._id %>" data-next="available">
                                <i class='bx bx-undo'></i> Mark available
                            </button>

                            <button type="button" class="mk-btn mk-btn-red own-del" data-id="<%= p._id %>" aria-label="Delete listing">
                                <i class='bx bx-trash'></i>
                            </button>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </section>

</main>


<%- include('partials/footer') %>

<script src="/script.js"></script>

<script>

(function () {

    const $ = (id) => document.getElementById(id);

    const tabs = document.querySelectorAll(".ptab");
    const ownMsg = $("ownMsg");


    // ---------- tabs (the address remembers which one you were on) ----------

    function showTab(name) {

        tabs.forEach((tab) => tab.classList.toggle("active", tab.dataset.tab === name));

        $("panel-forsale").classList.toggle("active", name === "forsale");
        $("panel-sold").classList.toggle("active", name === "sold");

    }

    tabs.forEach((tab) => {

        tab.addEventListener("click", () => {

            showTab(tab.dataset.tab);

            history.replaceState(null, "", "#" + tab.dataset.tab);

        });

    });

    if (window.location.hash === "#sold") {
        showTab("sold");
    }


    // ---------- mark sold / available, delete ----------

    async function post(url, body) {

        const response = await fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body || {}),
            credentials: "same-origin"
        });

        let data = {};

        try {
            data = await response.json();
        } catch (e) {}

        if (response.status === 401 || data.loginRequired) {
            window.location.href = "/login?redirect=/profile";
            return null;
        }

        return { ok: response.ok, data: data };

    }

    document.addEventListener("click", async (event) => {

        const statusBtn = event.target.closest(".own-status");
        const deleteBtn = event.target.closest(".own-del");

        const button = statusBtn || deleteBtn;

        if (!button) {
            return;
        }

        if (deleteBtn && !confirm("Delete this listing? The photos will be removed too. This cannot be undone.")) {
            return;
        }

        button.disabled = true;
        ownMsg.textContent = "";

        try {

            const result = statusBtn
                ? await post("/product/" + button.dataset.id + "/status", { status: button.dataset.next })
                : await post("/product/" + button.dataset.id + "/delete");

            if (result && result.ok) {

                // reload so the lists and counts are always correct (the address keeps your tab)
                window.location.reload();

                return;

            }

            if (result) {
                ownMsg.textContent = result.data.error || "Something went wrong. Please try again.";
            }

        } catch (error) {

            ownMsg.textContent = "Could not reach the server. Check your connection and try again.";

        }

        button.disabled = false;

    });

})();

</script>

<%- include('partials/serviceworker') %>

</body>
</html>
