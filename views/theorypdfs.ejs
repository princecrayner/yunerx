<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Past Theory Questions</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>


<body>


<div class="container">

    <h1>
        📖 Past Theory Questions
    </h1>

    <p>
        Select a semester.
    </p>

</div>



<div class="container">

    <% if (semesters.length === 0) { %>

        <p>
            No past theory questions available yet.
        </p>

    <% } %>



    <% semesters.forEach(semester => { %>

        <a
            href="/theory-pdfs/semester/<%= encodeURIComponent(semester) %>"
            class="btn"
        >

            📅 <%= semester %>

        </a>

    <% }) %>

</div>


</body>

</html>