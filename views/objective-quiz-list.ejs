<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= subject %> - Quizzes - Yunerx
    </title>

    <link rel="stylesheet" href="/style.css">

    <link
        href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
        rel="stylesheet"
    >

    <style>

        /* =====================================================
           CONTAINER
        ===================================================== */

        .quiz-container {

            max-width: 900px;

            margin: 30px auto;

            padding: 20px;

        }


        /* =====================================================
           BACK BUTTON
        ===================================================== */

        .back-btn {

            display: inline-flex;

            align-items: center;

            gap: 5px;

            margin-bottom: 25px;

            color: royalblue;

            text-decoration: none;

            font-size: 16px;

        }


        /* =====================================================
           HEADER
        ===================================================== */

        .quiz-header {

            text-align: center;

            margin-bottom: 25px;

        }


        .quiz-header h1 {

            margin-bottom: 8px;

        }


        .quiz-info {

            color: #777;

            font-size: 15px;

        }


        /* =====================================================
           SEARCH
        ===================================================== */

        .quiz-search {

            position: relative;

            max-width: 600px;

            margin: 0 auto 30px;

        }


        .quiz-search i {

            position: absolute;

            left: 15px;

            top: 50%;

            transform: translateY(-50%);

            font-size: 20px;

            color: #777;

        }


        .quiz-search input {

            width: 100%;

            box-sizing: border-box;

            padding: 14px 45px;

            border: 1px solid #ddd;

            border-radius: 10px;

            outline: none;

            font-size: 15px;

            background: white;

        }


        .quiz-search input:focus {

            border-color: royalblue;

        }


        /* =====================================================
           QUIZ LIST
        ===================================================== */

        .quiz-list {

            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));

            gap: 15px;

        }


        /* =====================================================
           QUIZ CARD
        ===================================================== */

        .quiz-card {

            display: flex;

            align-items: center;

            gap: 15px;

            padding: 20px;

            background: white;

            border: 1px solid #eee;

            border-radius: 12px;

            text-decoration: none;

            color: #222;

            box-shadow:
                0 3px 12px rgba(0,0,0,.08);

            transition:
                transform .2s,
                box-shadow .2s;

        }


        .quiz-card:hover {

            transform: translateY(-3px);

            box-shadow:
                0 6px 18px rgba(0,0,0,.12);

        }


        /* =====================================================
           QUIZ ICON
        ===================================================== */

        .quiz-icon {

            width: 45px;

            height: 45px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #f1f4ff;

            border-radius: 10px;

            font-size: 24px;

            flex-shrink: 0;

        }


        /* =====================================================
           QUIZ NAME
        ===================================================== */

        .quiz-name {

            font-size: 17px;

            font-weight: bold;

            color: royalblue;

        }


        /* =====================================================
           NO RESULTS
        ===================================================== */

        .empty {

            text-align: center;

            color: #777;

            padding: 40px;

        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 600px) {

            .quiz-container {

                margin: 20px auto;

                padding: 15px;

            }


            .quiz-list {

                grid-template-columns: 1fr;

            }


            .quiz-header h1 {

                font-size: 25px;

            }

        }

    </style>

</head>


<body>


<div class="quiz-container">


    <!-- =====================================================
         BACK TO SUBJECTS
    ===================================================== -->

    <a
        href="/objectivequizes"
        class="back-btn"
    >

        <i class="bx bx-arrow-back"></i>

        Back to Subjects

    </a>


    <!-- =====================================================
         HEADER
    ===================================================== -->

    <div class="quiz-header">

        <h1>

            📚 <%= subject %>

        </h1>


        <div class="quiz-info">

            Select a quiz to start answering questions.

        </div>

    </div>


    <!-- =====================================================
         SEARCH QUIZZES
    ===================================================== -->

    <div class="quiz-search">

        <i class="bx bx-search"></i>

        <input
            type="text"
            id="quizSearch"
            placeholder="Search quizzes..."
            autocomplete="off"
        >

    </div>


    <!-- =====================================================
         QUIZZES
    ===================================================== -->

    <% if (!quizzes || quizzes.length === 0) { %>


        <div class="empty">

            No quizzes available yet.

        </div>


    <% } else { %>


        <div
            class="quiz-list"
            id="quizList"
        >


            <% quizzes.forEach(quiz => { %>


                <a
                    href="/objectivequizes/subject/<%= encodeURIComponent(subject) %>/quiz/<%= encodeURIComponent(quiz) %>"
                    class="quiz-card"
                    data-quiz="<%= quiz.toLowerCase() %>"
                >


                    <div class="quiz-icon">

                        📝

                    </div>


                    <div class="quiz-name">

                        <%= quiz %>

                    </div>


                </a>


            <% }) %>


        </div>


        <div
            class="empty"
            id="noResults"
            style="display:none;"
        >

            No quizzes found.

        </div>


    <% } %>


</div>


<script>


// =====================================================
// QUIZ SEARCH
// =====================================================

const quizSearch =
    document.getElementById("quizSearch");


const quizCards =
    document.querySelectorAll(".quiz-card");


const noResults =
    document.getElementById("noResults");


if (quizSearch) {

    quizSearch.addEventListener(
        "input",
        function () {

            const search =
                this.value
                    .trim()
                    .toLowerCase();


            let visibleCount = 0;


            quizCards.forEach(card => {

                const quiz =
                    card.dataset.quiz;


                if (
                    quiz.includes(search)
                ) {

                    card.style.display =
                        "flex";

                    visibleCount++;

                } else {

                    card.style.display =
                        "none";

                }

            });


            if (noResults) {

                noResults.style.display =
                    visibleCount === 0
                        ? "block"
                        : "none";

            }

        }
    );

}


</script>


</body>

</html>
