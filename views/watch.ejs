<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= video.title %> - Yunerx</title>

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #111;
    color: white;
    font-family: Arial, Helvetica, sans-serif;
    padding-bottom: 40px;
}

.watch-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
}

.back-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #222;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 20px;
    flex-shrink: 0;
}

.main-video {
    width: 100%;
    aspect-ratio: 16/9;
    background: black;
}

.video-details {
    padding: 16px;
    border-bottom: 1px solid #333;
}

.video-details h1 {
    font-size: 18px;
    margin-bottom: 8px;
}

.video-details p {
    color: #aaa;
    font-size: 13px;
}

.suggestions-header {
    padding: 16px 16px 10px;
    font-size: 15px;
    font-weight: 600;
    color: #ccc;
}

.suggestion-item {
    display: flex;
    gap: 12px;
    padding: 10px 16px;
    text-decoration: none;
    color: white;
}

.suggestion-item:hover {
    background: #1a1a1a;
}

.suggestion-thumb {
    flex-shrink: 0;
    width: 140px;
    aspect-ratio: 16/9;
    border-radius: 8px;
    overflow: hidden;
    background: #222;
}

.suggestion-thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.suggestion-info {
    min-width: 0;
}

.suggestion-info h3 {
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

</style>

</head>
<body>

<div class="watch-header">
    <a href="/videos" class="back-btn">
        <i class='bx bx-arrow-back'></i>
    </a>
</div>

<video class="main-video" controls autoplay>
    <source src="<%= video.videoUrl %>">
</video>

<div class="video-details">
    <h1><%= video.title %></h1>
    <p>Uploaded <%= new Date(video.createdAt).toLocaleDateString() %></p>
</div>

<% if (suggestions.length > 0) { %>

    <div class="suggestions-header">Up next</div>

    <% suggestions.forEach(suggestion => { %>

        <a href="/watch/<%= suggestion._id %>" class="suggestion-item">

            <div class="suggestion-thumb">
                <video muted>
                    <source src="<%= suggestion.videoUrl %>">
                </video>
            </div>

            <div class="suggestion-info">
                <h3><%= suggestion.title %></h3>
            </div>

        </a>

    <% }) %>

<% } %>

</body>
</html>
