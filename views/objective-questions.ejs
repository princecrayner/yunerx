<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= quiz %> - <%= subject %> - Yunerx
    </title>

    <link rel="stylesheet" href="/style.css">

    <style>

        .questions-container {

            max-width: 900px;

            margin: 30px auto;

            padding: 20px;

        }


        .quiz-header {

            margin-bottom: 30px;

        }


        .quiz-header h1 {

            margin-bottom: 5px;

        }


        .quiz-header h2 {

            margin-top: 5px;

        }


        .quiz-info {

            color: #777;

        }


        .question-card {

            background: white;

            padding: 20px;

            margin-bottom: 20px;

            border-radius: 12px;

            box-shadow:
                0 3px 12px rgba(0,0,0,.1);

        }


        .question-number {

            color: royalblue;

            font-weight: bold;

        }


        .question-text {

            font-size: 18px;

            font-weight: 600;

            margin: 15px 0;

        }


        .option {

            display: block;

            padding: 12px;

            margin: 8px 0;

            border: 1px solid #ddd;

            border-radius: 8px;

            cursor: pointer;

        }


        .option:hover {

            background: #f5f7ff;

        }


        .option input {

            margin-right: 10px;

        }


        .submit-btn {

            width: 100%;

            padding: 14px;

            border: none;

            border-radius: 8px;

            background: royalblue;

            color: white;

            font-size: 16px;

            cursor: pointer;

        }


        .submit-btn:hover {

            opacity: .9;

        }


        .back-btn {

            display: inline-block;

            margin-bottom: 20px;

            color: royalblue;

            text-decoration: none;

        }
        
        
        .option.correct-answer {

    background: #dbeafe;

    border-color: royalblue;

}

.option.correct-answer input {

    accent-color: royalblue;

}


        .option.wrong-answer {

            background: #fee2e2;

            border-color: #ef4444;

        }


        .option.wrong-answer input {

            accent-color: #ef4444;

        }
        
        .result-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
}

.result-overlay.show {
    display: flex;
}

.result-modal {
    background: white;
    border-radius: 16px;
    padding: 30px 26px;
    max-width: 360px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0,0,0,0.25);
}

.result-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #dbeafe;
    color: royalblue;
    font-size: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
}

.result-modal h2 {
    font-size: 20px;
    color: #1a1a1a;
    margin-bottom: 10px;
}

.result-score {
    font-size: 17px;
    color: #444;
    margin-bottom: 6px;
}

.result-unanswered {
    font-size: 15px;
    color: #ef4444;
    margin-bottom: 20px;
}

.result-close-btn {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 10px;
    background: royalblue;
    color: white;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
}

.result-close-btn:hover {
    opacity: 0.9;
}

    </style>

</head>


<body>


<div class="questions-container">


    <!-- =====================================================
         BACK TO SUBJECT QUIZZES
    ===================================================== -->

    <a
        href="/objectivequizes/subject/<%= encodeURIComponent(subject) %>"
        class="back-btn"
    >

        ← Back to <%= subject %> Quizzes

    </a>


    <!-- =====================================================
         QUIZ HEADER
    ===================================================== -->

    <div class="quiz-header">

        <h1>

            <%= subject %>

        </h1>


        <h2>

            📝 <%= quiz %>

        </h2>


        <div class="quiz-info">

            <%= questions.length %>
            Questions

        </div>

    </div>


    <!-- =====================================================
         QUESTIONS
    ===================================================== -->

    <form
        action="#"
        method="POST"
        id="quizForm"
    >


        <% questions.forEach((question, index) => { %>


            <div class="question-card">


                <div class="question-number">

                    Question <%= index + 1 %>

                </div>


                <div class="question-text">

                    <%= question.question %>

                </div>


                <!-- OPTION A -->

                <label class="option">

                    <input
                        type="radio"
                        name="question_<%= index %>"
                        value="A"
                    >

                    <strong>A.</strong>

                    <%= question.options.A %>

                </label>


                <!-- OPTION B -->

                <label class="option">

                    <input
                        type="radio"
                        name="question_<%= index %>"
                        value="B"
                    >

                    <strong>B.</strong>

                    <%= question.options.B %>

                </label>


                <!-- OPTION C -->

                <label class="option">

                    <input
                        type="radio"
                        name="question_<%= index %>"
                        value="C"
                    >

                    <strong>C.</strong>

                    <%= question.options.C %>

                </label>


                <!-- OPTION D -->

                <label class="option">

                    <input
                        type="radio"
                        name="question_<%= index %>"
                        value="D"
                    >

                    <strong>D.</strong>

                    <%= question.options.D %>

                </label>


            </div>


        <% }) %>


        <!-- =================================================
             SUBMIT
        ================================================= -->

        <button
            type="button"
            class="submit-btn"
            onclick="submitQuiz()"
        >

            Submit Quiz

        </button>


    </form>
    
    
    <div class="result-overlay" id="resultOverlay">

    <div class="result-modal">

        <div class="result-icon">📊</div>

        <h2>Quiz Complete</h2>

        <div class="result-score" id="resultScore"></div>

        <div class="result-unanswered" id="resultUnanswered"></div>

        <button class="result-close-btn" onclick="closeResultModal()">Close</button>

    </div>

</div>


</div>


<script>


// =====================================================
// SUBMIT QUIZ
// =====================================================

function submitQuiz() {


    const questions =
        <%- JSON.stringify(
            questions.map(q => ({
                answer: q.answer,
                explanation: q.explanation
            }))
        ) %>;


    let score = 0;

    let unanswered = 0;


    questions.forEach(
        (question, index) => {


            const selected =
                document.querySelector(
                    `input[name="question_${index}"]:checked`
                );


            // ---------------------------------------------
            // UNANSWERED
            // ---------------------------------------------

            if (!selected) {

                unanswered++;

                return;

            }


            // ---------------------------------------------
            // CORRECT
            // ---------------------------------------------

            if (
                selected.value === question.answer
            ) {

                score++;
                
                 selected
               .closest(".option")
               .classList.add("correct-answer");

            }


            // ---------------------------------------------
            // WRONG
            // ---------------------------------------------

            else {

                selected
                    .closest(".option")
                    .classList.add(
                        "wrong-answer"
                    );

            }

        }
    );


    // =====================================================
    // RESULT
    // =====================================================

    document.getElementById("resultScore").textContent =
        `You scored ${score} out of ${questions.length}.`;

    const unansweredEl = document.getElementById("resultUnanswered");

    if (unanswered > 0) {
        unansweredEl.textContent = `Unanswered questions: ${unanswered}`;
        unansweredEl.style.display = "block";
    } else {
        unansweredEl.style.display = "none";
    }

    document.getElementById("resultOverlay").classList.add("show");

}


function closeResultModal() {
    document.getElementById("resultOverlay").classList.remove("show");
}



</script>


<%- include('partials/serviceworker') %>

</body>

</html>
