<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Objective Quizzes - Yunerx</title>

    <link rel="stylesheet" href="/style.css">

    <link
        href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
        rel="stylesheet"
    >

    <style>

        /* =====================================================
           QUIZ CONTAINER
        ===================================================== */

        .quiz-container {

            max-width: 900px;

            margin: 30px auto;

            padding: 20px;

        }


        /* =====================================================
           BACK BUTTON
        ===================================================== */

        .back-btn {

            display: inline-flex;

            align-items: center;

            gap: 5px;

            margin-bottom: 20px;

            text-decoration: none;

            color: royalblue;

        }


        /* =====================================================
           TITLE
        ===================================================== */

        .quiz-container h1 {

            text-align: center;

            margin-bottom: 10px;

        }


        .quiz-description {

            text-align: center;

            color: #777;

            margin-bottom: 25px;

        }


        /* =====================================================
           SEARCH
        ===================================================== */

        .quiz-search {

            position: relative;

            max-width: 600px;

            margin: 0 auto 30px;

        }


        .quiz-search i {

            position: absolute;

            left: 15px;

            top: 50%;

            transform: translateY(-50%);

            font-size: 20px;

            color: #777;

        }


        .quiz-search input {

            width: 100%;

            box-sizing: border-box;

            padding: 14px 45px;

            border: 1px solid #ddd;

            border-radius: 10px;

            outline: none;

            font-size: 15px;

            background: white;

        }


        .quiz-search input:focus {

            border-color: royalblue;

        }


        /* =====================================================
           SUBJECT LIST
        ===================================================== */

        .subjects-list {

            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            gap: 15px;

        }


        /* =====================================================
           SUBJECT BUTTON
        ===================================================== */

        .subject-btn {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 10px;

            padding: 18px;

            background: white;

            border: 1px solid #eee;

            border-radius: 12px;

            text-decoration: none;

            color: #222;

            box-shadow:
                0 3px 12px rgba(0,0,0,.07);

            transition:
                transform .2s,
                box-shadow .2s;

        }


        .subject-btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 5px 16px rgba(0,0,0,.12);

        }


        .subject-left {

            display: flex;

            align-items: center;

            gap: 12px;

        }


        .subject-icon {

            width: 42px;

            height: 42px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 10px;

            background: #f1f4ff;

            color: royalblue;

            font-size: 22px;

            flex-shrink: 0;

        }


        .subject-name {

            font-size: 16px;

            font-weight: 600;

        }


        .subject-arrow {

            font-size: 22px;

            color: #999;

        }


        /* =====================================================
           EMPTY / NO SEARCH RESULTS
        ===================================================== */

        .empty {

            text-align: center;

            color: #777;

            padding: 30px;

        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 600px) {

            .quiz-container {

                margin: 20px auto;

                padding: 15px;

            }


            .subjects-list {

                grid-template-columns: 1fr;

            }


            .quiz-container h1 {

                font-size: 25px;

            }

        }

    </style>

</head>


<body>


<div class="quiz-container">


    <!-- =====================================================
         BACK HOME
    ===================================================== -->

    <a
        href="/"
        class="back-btn"
    >

        <i class="bx bx-arrow-back"></i>

        Back Home

    </a>


    <!-- =====================================================
         TITLE
    ===================================================== -->

    <h1>
        📚 Objective Quizzes
    </h1>


    <p class="quiz-description">

        Choose a subject to see its available quizzes.

    </p>


    <!-- =====================================================
         SEARCH BAR
    ===================================================== -->

    <div class="quiz-search">

        <i class="bx bx-search"></i>

        <input
            type="text"
            id="subjectSearch"
            placeholder="Search subjects..."
            autocomplete="off"
        >

    </div>


    <!-- =====================================================
         SUBJECTS
    ===================================================== -->

    <% if (!subjects || subjects.length === 0) { %>


        <div class="empty">

            No objective quizzes have been uploaded yet.

        </div>


    <% } else { %>


        <div
            class="subjects-list"
            id="subjectsList"
        >


            <% subjects.forEach(subject => { %>


                <a
                    href="/objectivequizes/subject/<%= encodeURIComponent(subject) %>"
                    class="subject-btn"
                    data-subject="<%= subject.toLowerCase() %>"
                >


                    <div class="subject-left">


                        <div class="subject-icon">

                            <i class="bx bx-book-open"></i>

                        </div>


                        <span class="subject-name">

                            <%= subject %>

                        </span>


                    </div>


                    <i class="bx bx-chevron-right subject-arrow"></i>


                </a>


            <% }) %>


        </div>


        <div
            class="empty"
            id="noResults"
            style="display:none;"
        >

            No subjects found.

        </div>


    <% } %>


</div>


<script>


// =====================================================
// SUBJECT SEARCH
// =====================================================

const subjectSearch =
    document.getElementById("subjectSearch");

const subjectButtons =
    document.querySelectorAll(".subject-btn");

const noResults =
    document.getElementById("noResults");


if (subjectSearch) {

    subjectSearch.addEventListener(
        "input",
        function () {

            const search =
                this.value
                    .trim()
                    .toLowerCase();


            let visibleCount = 0;


            subjectButtons.forEach(button => {

                const subject =
                    button.dataset.subject;


                if (
                    subject.includes(search)
                ) {

                    button.style.display =
                        "flex";

                    visibleCount++;

                } else {

                    button.style.display =
                        "none";

                }

            });


            if (noResults) {

                noResults.style.display =
                    visibleCount === 0
                        ? "block"
                        : "none";

            }

        }
    );

}


</script>


</body>

</html>
