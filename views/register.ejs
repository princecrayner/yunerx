<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>

<style>

/* =========================
   REGISTER PAGE
========================= */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #eef2ff, #f8fafc, #e0e7ff);
    display: flex;
    justify-content: center;
    align-items: center;
}

/* Register container */
.auth-box {
    width: 90%;
    max-width: 420px;
    padding: 35px 30px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 24px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
}



/* Heading */
.auth-box h2 {
    color: #111827;
    font-size: 30px;
    font-weight: 700;
    margin: 0 0 22px;
}

/* Form */
.auth-box form {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* Inputs */
.auth-box input {
    width: 100%;
    height: 52px;
    padding: 0 17px;
    margin: 7px 0;
    border: 1.5px solid #d1d5db;
    border-radius: 14px;
    background: #f9fafb;
    color: #111827;
    font-size: 15px;
    outline: none;
    transition: 0.25s ease;
}

.auth-box input::placeholder {
    color: #9ca3af;
}

.auth-box input:focus {
    border-color: #6366f1;
    background: white;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
}

/* Register button */
.auth-box button {
    width: 100%;
    height: 52px;
    margin-top: 14px;
    border: none;
    border-radius: 14px;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 18px rgba(79, 70, 229, 0.25);
    transition: 0.25s ease;
}

.auth-box button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(79, 70, 229, 0.35);
}

.auth-box button:active {
    transform: scale(0.98);
}

/* Login link */
.auth-box a {
    margin-top: 22px;
    text-decoration: none;
    color: #4f46e5;
    font-size: 15px;
    font-weight: 600;
    transition: 0.2s ease;
}

.auth-box a:hover {
    color: #312e81;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 480px) {

    body {
        padding: 40px;
    }

    .auth-box {
        width: 100%;
        padding: 30px 30px;
        border-radius: 20px;
    }

    .auth-box h2 {
        font-size: 27px;
    }
}

/* =========================
   DESKTOP
========================= */

@media (min-width: 768px) {

    .auth-box {
        max-width: 400px;
        padding: 40px 35px;
    }
}


#toast {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(-20px);
    background: #dc2626;
    color: white;
    padding: 14px 22px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    z-index: 1000;
    max-width: 90%;
    text-align: center;
}

#toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}

</style>

</head>
<body>

<div class="auth-box">

<h2>Create Account</h2>

<form action="/register" method="POST" id="registerForm">

<input type="text" name="username" id="username" placeholder="Username" required>

<input type="email" name="email" id="email" placeholder="Email" required>

<input type="text" name="phone" id="phone" placeholder="Phone Number" required>

<input type="password" name="password" id="password" placeholder="Password" required>

<button type="submit">Register</button>

</form>

<a href="/login">Already have account?</a>

</div>

<div id="toast"></div>



<script>

const form = document.getElementById("registerForm");
const toast = document.getElementById("toast");

let toastTimeout;

function showToast(message) {

    clearTimeout(toastTimeout);

    toast.textContent = message;
    toast.classList.add("show");

    toastTimeout = setTimeout(() => {
        toast.classList.remove("show");
    }, 3500);

}

form.addEventListener("submit", function(event) {

    const username = document.getElementById("username").value.trim();
    const email = document.getElementById("email").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const password = document.getElementById("password").value;

    if (!username || !email || !phone || !password) {
        event.preventDefault();
        showToast("All fields are required.");
        return;
    }

    if (username.length < 4) {
        event.preventDefault();
        showToast("Username must be at least 4 characters.");
        return;
    }

    if (username.length > 20) {
        event.preventDefault();
        showToast("Username must be no more than 20 characters.");
        return;
    }

    if (password.length < 8) {
        event.preventDefault();
        showToast("Password must be at least 8 characters.");
        return;
    }

    if (password.length > 20) {
        event.preventDefault();
        showToast("Password must be no more than 20 characters.");
        return;
    }

});


// Show a server-side error message if redirected back with one
const urlParams = new URLSearchParams(window.location.search);
const serverError = urlParams.get("error");

if (serverError) {
    showToast(decodeURIComponent(serverError));
}

</script>

<%- include('partials/serviceworker') %>

</body>
</html>
