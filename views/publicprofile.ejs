<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title><%= seller.username %> - Yunerx</title>

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<%- include('partials/market-styles') %>

<style>

.prof-card {
    max-width: 640px; margin: 0 auto; background: #fff; border-radius: 18px;
    padding: 20px 16px; text-align: center; box-shadow: 0 3px 15px rgba(0,0,0,.06);
}

.prof-avatar { width: 96px; height: 96px; font-size: 84px; margin: 0 auto 10px; border: 3px solid #4169e1; }

.prof-card h2 { margin: 0; font-size: 22px; word-break: break-word; }
.prof-card .since { margin: 4px 0 0; color: #778; font-size: 13px; }

.stats { display: flex; justify-content: center; margin: 16px 0; }
.stat { flex: 1; max-width: 120px; }
.stat b { display: block; font-size: 20px; color: #3557c7; }
.stat span { font-size: 12px; color: #778; }

.ptabs {
    display: flex; gap: 8px; max-width: 640px; margin: 18px auto 14px;
    background: #e4e9f5; padding: 5px; border-radius: 14px;
}

.ptab {
    flex: 1; border: none; background: transparent; padding: 11px 8px; border-radius: 10px;
    font-size: 14px; font-weight: 700; color: #667; cursor: pointer; font-family: inherit;
}

.ptab.active { background: #fff; color: #3557c7; box-shadow: 0 2px 8px rgba(0,0,0,.08); }

.panel { display: none; }
.panel.active { display: block; }

.p-empty { text-align: center; padding: 40px 20px; color: #778; }
.p-empty i { font-size: 52px; color: #9aa4c4; display: block; margin-bottom: 8px; }
.p-empty h3 { margin: 0 0 6px; color: #1a1a1a; }
.p-empty p { margin: 0; font-size: 14px; }

</style>

</head>

<body class="page-market">

<header class="page-top">
    <h1>Marketplace</h1>
</header>

<main class="mk">

    <div class="mk-head">
        <button type="button" class="mk-back" id="backBtn" aria-label="Go back"><i class='bx bx-arrow-back'></i></button>
        <h1>Seller</h1>
    </div>

    <section class="prof-card">

        <div class="avatar prof-avatar">
            <i class='bx bxs-user-circle'></i>
            <% if (seller.profileImage) { %>
                <img src="<%= seller.profileImage %>" alt="" onerror="this.remove()">
            <% } %>
        </div>

        <h2><%= seller.username %></h2>

        <p class="since">Member since <%= memberSince.toLocaleDateString("en-US", { month: "long", year: "numeric" }) %></p>

        <div class="stats">
            <div class="stat"><b><%= forSale.length %></b><span>For sale</span></div>
            <div class="stat"><b><%= soldCount %></b><span>Sold</span></div>
        </div>

        <a href="/chat/<%= encodeURIComponent(seller.username) %>" class="mk-btn mk-btn-blue">
            <i class='bx bx-message-rounded-dots'></i> Message <%= seller.username %>
        </a>

    </section>

    <div class="ptabs">
        <button type="button" class="ptab active" data-tab="forsale">For sale (<%= forSale.length %>)</button>
        <button type="button" class="ptab" data-tab="sold">Sold (<%= soldCount %>)</button>
    </div>

    <section class="panel active" id="panel-forsale">

        <% if (forSale.length === 0) { %>

            <div class="p-empty">
                <i class='bx bx-store'></i>
                <h3>Nothing for sale right now</h3>
                <p>Check back soon.</p>
            </div>

        <% } else { %>

            <div class="pgrid">
                <% forSale.forEach(function (p) { %>
                    <%- include('partials/product-card', { p: p }) %>
                <% }) %>
            </div>

        <% } %>

    </section>

    <section class="panel" id="panel-sold">

        <% if (sold.length === 0) { %>

            <div class="p-empty">
                <i class='bx bx-check-circle'></i>
                <h3>Nothing sold yet</h3>
                <p>Sold items show up here.</p>
            </div>

        <% } else { %>

            <div class="pgrid">
                <% sold.forEach(function (p) { %>
                    <%- include('partials/product-card', { p: p }) %>
                <% }) %>
            </div>

        <% } %>

    </section>

</main>


<%- include('partials/footer') %>

<script>

(function () {

    const $ = (id) => document.getElementById(id);

    const tabs = document.querySelectorAll(".ptab");

    function showTab(name) {

        tabs.forEach((tab) => tab.classList.toggle("active", tab.dataset.tab === name));

        $("panel-forsale").classList.toggle("active", name === "forsale");
        $("panel-sold").classList.toggle("active", name === "sold");

    }

    tabs.forEach((tab) => tab.addEventListener("click", () => showTab(tab.dataset.tab)));

    $("backBtn").addEventListener("click", () => {

        if (history.length > 1) {
            history.back();
        } else {
            window.location.href = "/market";
        }

    });

})();

</script>

<%- include('partials/serviceworker') %>

</body>
</html>
