<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Chat with <%= otherUser %>
    </title>

    <link
        href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
        rel="stylesheet"
    >

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            width: 100%;
            height: 100%;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
        }


        /* ================================
           CHAT PAGE
        ================================= */

        .chat-page {
            width: 100%;
            height: 100vh;

            display: flex;
            flex-direction: column;
        }


        /* ================================
           HEADER
        ================================= */

        .chat-header {
            height: 70px;

            background: white;

            display: flex;
            align-items: center;

            gap: 12px;

            padding: 10px 16px;

            border-bottom: 1px solid #eee;

            flex-shrink: 0;
        }


        .back-btn {
            width: 42px;
            height: 42px;

            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            text-decoration: none;

            color: #333;

            font-size: 25px;
        }

        .back-btn:hover {
            background: #f2f3f7;
        }


        /* ================================
           AVATAR
        ================================= */

        .chat-avatar {
            width: 45px;
            height: 45px;

            border-radius: 50%;

            background: #e9edf7;

            color: #4169e1;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 22px;

            flex-shrink: 0;
        }


        /* ================================
           USER INFO
        ================================= */

        .chat-user-info {
            min-width: 0;
        }

        .chat-user-info h2 {
            font-size: 16px;

            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-user-info p {
            font-size: 12px;

            color: #888;

            margin-top: 3px;
        }


        /* ================================
           MESSAGE AREA
        ================================= */

        .messages-container {
            flex: 1;

            overflow-y: auto;

            padding: 20px;

            display: flex;
            flex-direction: column;

            gap: 9px;
        }


        /* ================================
           MESSAGE
        ================================= */

        .message {
            max-width: 75%;

            padding: 10px 13px;

            border-radius: 15px;

            font-size: 14px;

            line-height: 1.4;

            word-wrap: break-word;
        }


        /* MY MESSAGE */

        .message.mine {
            align-self: flex-end;

            background: #4169e1;

            color: white;

            border-bottom-right-radius: 4px;
        }


        /* OTHER USER */

        .message.theirs {
            align-self: flex-start;

            background: white;

            color: #222;

            border-bottom-left-radius: 4px;

            box-shadow:
                0 2px 8px rgba(0,0,0,0.05);
        }


        .message-time {
            display: block;

            font-size: 10px;

            margin-top: 4px;

            opacity: 0.7;

            text-align: right;
        }


        /* ================================
           EMPTY CHAT
        ================================= */

        .empty-chat {
            margin: auto;

            text-align: center;

            color: #888;
        }

        .empty-chat i {
            font-size: 50px;

            color: #4169e1;

            display: block;

            margin-bottom: 10px;
        }

        .empty-chat p {
            font-size: 14px;
        }


        /* ================================
           INPUT AREA
        ================================= */

        .message-form {
            min-height: 68px;

            background: white;

            border-top: 1px solid #eee;

            display: flex;
            align-items: center;

            gap: 10px;

            padding: 10px 14px;

            flex-shrink: 0;
        }


        .message-input {
            flex: 1;

            height: 46px;

            border: none;

            outline: none;

            background: #f1f3f7;

            border-radius: 23px;

            padding: 0 17px;

            font-size: 14px;
        }


        .send-btn {
            width: 46px;
            height: 46px;

            border: none;

            border-radius: 50%;

            background: #4169e1;

            color: white;

            font-size: 22px;

            cursor: pointer;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .send-btn:hover {
            opacity: 0.9;
        }


        /* ================================
           DESKTOP
        ================================= */

        @media (min-width: 800px) {

            .chat-page {
                width: 700px;

                height: 90vh;

                margin: 5vh auto;

                background: white;

                border-radius: 18px;

                overflow: hidden;

                box-shadow:
                    0 10px 35px rgba(0,0,0,0.10);
            }

            body {
                background: #eef1f7;
            }

            .messages-container {
                padding: 25px;
            }

        }


        /* ================================
           SMALL MOBILE
        ================================= */

        @media (max-width: 400px) {

            .chat-header {
                padding: 9px;
            }

            .messages-container {
                padding: 12px;
            }

            .message {
                max-width: 82%;
            }

        }

    </style>

</head>


<body>


<div class="chat-page">


    <!-- =================================
         HEADER
    ================================= -->

    <header class="chat-header">

        <a
            href="/chats"
            class="back-btn"
        >
            <i class='bx bx-arrow-back'></i>
        </a>


        <div class="chat-avatar">

            <i class='bx bx-user'></i>

        </div>


        <div class="chat-user-info">

            <h2>
                <%= otherUser %>
            </h2>

            <p>
                Yunerx user
            </p>

        </div>

    </header>



    <!-- =================================
         MESSAGES
    ================================= -->

    <main
        class="messages-container"
        id="messagesContainer"
    >

        <% if (messages && messages.length > 0) { %>


            <% messages.forEach(msg => { %>

                <div
                    class="message <%= msg.sender === currentUser ? 'mine' : 'theirs' %>"
                >

                    <%= msg.message %>


                    <% if (msg.time) { %>

                        <small class="message-time">
                            <%= msg.time %>
                        </small>

                    <% } %>

                </div>

            <% }) %>


        <% } else { %>


            <div class="empty-chat">

                <i class='bx bx-message-rounded-dots'></i>

                <p>
                    No messages yet.
                </p>

                <p>
                    Start the conversation.
                </p>

            </div>


        <% } %>

    </main>



    <!-- =================================
         MESSAGE FORM
    ================================= -->

    <form
        class="message-form"
        id="messageForm"
    >

        <input
            type="text"
            id="messageInput"
            class="message-input"
            placeholder="Type a message..."
            autocomplete="off"
            required
        >


        <button
            type="submit"
            class="send-btn"
        >

            <i class='bx bx-send'></i>

        </button>

    </form>


</div>



<script>

/* =========================================
   AUTO SCROLL
========================================= */

const messagesContainer =
    document.getElementById(
        "messagesContainer"
    );

messagesContainer.scrollTop =
    messagesContainer.scrollHeight;


/* =========================================
   FORM
========================================= */

const messageForm =
    document.getElementById(
        "messageForm"
    );

const messageInput =
    document.getElementById(
        "messageInput"
    );


/*
    Socket.IO will be connected
    in the next step.

    For now we only prepare
    the form.
*/

<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

const messagesContainer =
    document.getElementById("messagesContainer");

const messageForm =
    document.getElementById("messageForm");

const messageInput =
    document.getElementById("messageInput");


/* =========================================
   CURRENT USER
========================================= */

const currentUser =
    <%- JSON.stringify(currentUser) %>;

socket.emit(
    "joinUser",
    currentUser
);

/* =========================================
   OTHER USER
========================================= */

const otherUser =
    <%- JSON.stringify(otherUser) %>;


/* =========================================
   AUTO SCROLL
========================================= */

function scrollToBottom() {

    messagesContainer.scrollTop =
        messagesContainer.scrollHeight;

}

scrollToBottom();


/* =========================================
   SEND MESSAGE
========================================= */

messageForm.addEventListener(
    "submit",
    function(event) {

        event.preventDefault();

        const text =
            messageInput.value.trim();

        if (!text) {
            return;
        }


        const now = new Date();


        const messageData = {

            sender: currentUser,

            receiver: otherUser,

            message: text,

            date: now.toLocaleDateString(),

            time: now.toLocaleTimeString()

        };


        socket.emit(
            "sendMessage",
            messageData
        );


        messageInput.value = "";

        messageInput.focus();

    }
);


/* =========================================
   RECEIVE MESSAGE
========================================= */

socket.on(
    "receivePrivateMessage",
    function(data) {

        /*
        Only display messages belonging
        to this conversation.
        */

        const belongsToConversation =

            (
                data.sender === currentUser &&
                data.receiver === otherUser
            )

            ||

            (
                data.sender === otherUser &&
                data.receiver === currentUser
            );


        if (!belongsToConversation) {
            return;
        }


        const div =
            document.createElement("div");


        div.classList.add("message");


        if (data.sender === currentUser) {

            div.classList.add("mine");

        } else {

            div.classList.add("theirs");

        }


        div.innerHTML = `

            ${escapeHtml(data.message)}

            <small class="message-time">
                ${escapeHtml(data.time || "")}
            </small>

        `;


        messagesContainer.appendChild(div);


        scrollToBottom();

    }
);


/* =========================================
   ESCAPE HTML
========================================= */

function escapeHtml(text) {

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}

</script>

</script>


</body>

</html>
