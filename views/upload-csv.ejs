<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Upload Questions CSV</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
        }

        .container {
            width: 90%;
            max-width: 700px;
            margin: 50px auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        h1 {
            margin-top: 0;
        }

        .info {
            background: #eef5ff;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        input[type="file"] {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            margin: 15px 0;
        }

        button {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 6px;
            background: #222;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        button:hover {
            opacity: 0.85;
        }

        .success {
            background: #e8f8ee;
            color: #176b36;
            padding: 15px;
            border-radius: 7px;
            margin-bottom: 20px;
        }

        .error {
            background: #ffecec;
            color: #a00000;
            padding: 15px;
            border-radius: 7px;
            margin-bottom: 20px;
        }

        .error ul {
            margin-bottom: 0;
        }

        code {
            background: #eee;
            padding: 2px 5px;
            border-radius: 4px;
        }

    </style>

</head>

<body>

<div class="container">

    <h1>Upload Questions CSV</h1>


    <div class="info">

        <strong>CSV columns:</strong>

        <p>
            level, section, subject, category,
            question, optionA, optionB, optionC,
            optionD, answer, explanation
        </p>

        <p>
            Answer must be:
            <code>A</code>,
            <code>B</code>,
            <code>C</code>,
            or <code>D</code>.
        </p>

    </div>


    <% if (success) { %>

        <div class="success">
            <%= success %>
        </div>

    <% } %>


    <% if (error) { %>

        <div class="error">
            <%= error %>
        </div>

    <% } %>


    <% if (errors && errors.length) { %>

        <div class="error">

            <strong>
                CSV contains errors:
            </strong>

            <ul>

                <% errors.forEach(function(item) { %>

                    <li>
                        <%= item %>
                    </li>

                <% }); %>

            </ul>

        </div>

    <% } %>


    <form
        action="/admin/upload-csv"
        method="POST"
        enctype="multipart/form-data"
    >

        <label>
            Select CSV file
        </label>

        <input
            type="file"
            name="csvFile"
            accept=".csv,text/csv"
            required
        >

        <button type="submit">
            Upload Questions
        </button>

    </form>

</div>

</body>

</html>