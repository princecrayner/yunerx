<style>

body.page-market {
    margin: 0;
    padding: 0 0 110px;                 /* room for the mobile footer */
    background: #f5f7fb;
    color: #1a1a1a;
    font-family: Arial, Helvetica, sans-serif;
}

.page-top { display: none; }            /* desktop only */

.mk,
.mk * { box-sizing: border-box; }

.mk [hidden] { display: none !important; }

.mk { max-width: 1100px; margin: 0 auto; padding: 16px; }

/* header with the back arrow */

.mk-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
.mk-head h1 { margin: 0; font-size: 22px; }

.mk-back {
    width: 40px; height: 40px; flex-shrink: 0;
    border: none; border-radius: 50%;
    background: #fff; color: #1a1a1a; font-size: 22px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,.08);
}

/* buttons */

.mk-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border: none; border-radius: 12px; padding: 13px 20px;
    font-size: 15px; font-weight: 700; font-family: inherit;
    text-decoration: none; cursor: pointer;
}

.mk-btn:disabled { opacity: .6; cursor: not-allowed; }
.mk-btn-blue { background: #4169e1; color: #fff; }
.mk-btn-light { background: #fff; color: #3557c7; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
.mk-btn-red { background: #fff; color: #c0392b; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
.mk-btn-block { width: 100%; }

.section-title { font-size: 18px; margin: 26px 0 12px; }

/* product cards */

.pgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }

.pcard {
    display: block; background: #fff; border-radius: 14px; overflow: hidden;
    text-decoration: none; color: inherit; box-shadow: 0 2px 10px rgba(0,0,0,.06);
}

.pcard-img {
    position: relative; aspect-ratio: 1 / 1; background: #e9edf7;
    display: flex; align-items: center; justify-content: center;
    color: #9aa4c4; font-size: 42px;
}

.pcard-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

.pcard-sold {
    position: absolute; top: 8px; left: 8px; background: #dc2626; color: #fff;
    font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 6px; letter-spacing: .5px;
}

.pcard-neg {
    position: absolute; bottom: 8px; left: 8px; background: rgba(0,0,0,.65); color: #fff;
    font-size: 11px; padding: 3px 8px; border-radius: 10px;
}

.pcard-body { padding: 10px 12px 12px; }
.pcard-price { font-size: 16px; font-weight: 800; color: #3557c7; }

.pcard-title {
    font-size: 14px; margin-top: 3px; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

.pcard-meta { font-size: 12px; color: #888; margin-top: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* seller avatar */

.avatar {
    position: relative; width: 44px; height: 44px; flex-shrink: 0; border-radius: 50%;
    background: #e9edf7; color: #4169e1; font-size: 30px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
}

.avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

/* desktop: the footer is a 220px sidebar on the left, with a 65px top bar above it */

@media (min-width: 768px) {

    body.page-market { padding: 90px 28px 40px 248px; }

    .page-top {
        display: flex; align-items: center;
        position: fixed; top: 0; left: 0; right: 0; height: 65px; padding: 0 24px;
        background: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.08); z-index: 1000;
    }

    .page-top h1 { margin: 0; font-size: 20px; }

    .mk { padding: 0; }

    .pgrid { grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 18px; }

}

</style>
