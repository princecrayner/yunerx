<a href="/product/<%= p._id %>" class="pcard" data-id="<%= p._id %>">

    <div class="pcard-img">

        <i class='bx bx-image'></i>

        <% if (p.images && p.images.length) { %>
            <img src="<%= thumb(p.images[0].url, 400, 400) %>" alt="" loading="lazy" onerror="this.remove()">
        <% } %>

        <% if (p.status === "sold") { %>
            <span class="pcard-sold">SOLD</span>
        <% } else if (p.negotiable) { %>
            <span class="pcard-neg">Negotiable</span>
        <% } %>

        <span class="heart" role="button" tabindex="0" aria-label="Save item" data-id="<%= p._id %>"><i class='bx bx-heart'></i></span>

    </div>

    <div class="pcard-body">
        <div class="pcard-price"><%= formatPrice(p.price) %></div>
        <div class="pcard-title"><%= p.title %></div>
        <div class="pcard-meta"><%= p.condition ? p.condition + " · " : "" %><%= p.location || "On campus" %></div>
    </div>

</a>
