<!DOCTYPE html>
<html>
<head>

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Users</title>

    <link rel="stylesheet" href="/css/chats.css">

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
        }
        
        .contacts-search {
    display: flex;
    align-items: center;
    gap: 10px;

    width: 100%;
    max-width: 600px;

    margin: 20px auto;
    padding: 12px 16px;

    background: #f1f3f5;
    border-radius: 25px;
}

.contacts-search i {
    font-size: 20px;
    color: #666;
}

.contacts-search input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;

    font-size: 15px;
}


.contacts-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 20px;
}

.contacts-header h1 {
    margin-bottom: 5px;
    color: black;
}

.contacts-header p {
    font-size: 13px;
    color: #888;
}

.contacts-count {
    min-width: 30px;
    height: 30px;

    padding: 0 8px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #4169e1;
    color: white;

    font-size: 13px;
    font-weight: bold;
}
        
        
        .no-contacts {
    text-align: center;
    padding: 50px 20px;
    color: #777;
}

.no-contacts i {
    font-size: 50px;
    margin-bottom: 12px;
}

.no-contacts h3 {
    color: #333;
    margin-bottom: 6px;
}

.no-contacts p {
    font-size: 14px;
}

        .chat-container {
            width: 100%;
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
        }

        .chat-container h1 {
            margin-bottom: 20px;
        }

        .message {
            background: white;
            padding: 16px;
            margin-bottom: 10px;
            border-radius: 12px;

            display: flex;
            align-items: center;
            gap: 12px;

            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .user-info {
            flex: 1;
            min-width: 0;
        }

        .user-info h3 {
            font-size: 16px;
            margin-bottom: 4px;
            color: black;
        }

        .user-info p {
            font-size: 13px;
            color: #888;
        }

        .chat-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            padding: 9px 16px;

            background: #4169e1;
            color: white;

            border-radius: 8px;

            text-decoration: none;

            font-size: 14px;
            font-weight: bold;

            flex-shrink: 0;
        }

        .chat-button:hover {
            opacity: 0.9;
        }

        @media (max-width: 500px) {

            .chat-container {
                padding: 14px;
            }

            .message {
                padding: 13px;
            }

            .chat-button {
                padding: 8px 12px;
            }

        }

    </style>

</head>

<body>

<div class="chat-container">


<form action="/users" method="GET" class="contacts-search">
    <i class='bx bx-search'></i>

    <input
        type="text"
        name="search"
        placeholder="Search Yunerx users..."
        value="<%= search || '' %>"
    >
</form>

<div class="contacts-header">
    <div>
        <h1>Contacts</h1>
        <p>Yunerx users you can chat with</p>
    </div>

    <span class="contacts-count">
        <%= users.length %>
    </span>
</div>


<% if (users.length === 0) { %>

    <div class="no-contacts">
        <i class='bx bx-user-x'></i>
        <h3>No users found</h3>
        <p>Try searching for another username.</p>
    </div>

<% } %>


    <% users.forEach(user => { %>

        <div class="message">

            <div class="user-info">

                <h3>
                    <%= user.username %>
                </h3>

                <p>
                    <%= user.phone %>
                </p>

            </div>

            <a
                href="/chat/<%= encodeURIComponent(user.username) %>"
                class="chat-button"
            >
                Chat
            </a>

        </div>

    <% }) %>

</div>

</body>
</html>
