<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Chats</title>

<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

<style>

/* =========================================
   RESET + PAGE
========================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html,
body {
    width: 100%;
    min-height: 100dvh;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f7fb;
    color: #222;
}

.chat-page {
    width: 100%;
    min-height: 100dvh;
    padding-bottom: 130px;      /* room for the global footer */
}

.chat-main {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    overflow: hidden;
}


/* =========================================
   SHARED TOP AREA (always visible)
========================================= */

.chat-top {
    padding: 18px 18px 0;
}

.chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 20px;
}

.chat-header h1 {
    font-size: 27px;
    font-weight: 700;
    margin-bottom: 5px;
}

.chat-header p {
    color: #777;
    font-size: 14px;
}

.contacts-button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 20px;
    text-decoration: none;
    background: #f1f3f5;
    color: #222;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s ease;
}

.contacts-button:hover {
    background: #e2e6ea;
}

.contacts-button i {
    font-size: 18px;
}


/* ---------- stories ---------- */

.stories-section {
    background: white;
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 18px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.06);
}

.section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.section-title h2 {
    font-size: 18px;
}

.story-more,
.search-chat-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 23px;
    color: #555;
}

.stories-container {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scrollbar-width: none;
}

.stories-container::-webkit-scrollbar {
    display: none;
}

.stories-container a {
    text-decoration: none;
}

.story {
    flex: 0 0 72px;
    text-align: center;
    cursor: pointer;
}

.story-image {
    width: 64px;
    height: 64px;
    margin: 0 auto 7px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e9edf7;
    border: 3px solid #4169e1;
    color: #4169e1;
    font-size: 25px;
}

.story span {
    display: block;
    font-size: 12px;
    color: #444;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.create-story .story-image {
    border: 3px dashed #4169e1;
    background: #f0f3ff;
}


/* ---------- Messages | Groups buttons ---------- */

.chat-tabs {
    display: flex;
    height: 56px;
    background: rgba(255,255,255,0.97);
    border-bottom: 1px solid #e7e7e7;
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -3px 15px rgba(0,0,0,0.05);
    overflow: hidden;
}

.chat-tab {
    flex: 1;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: #888;
    transition: 0.25s;
}

.chat-tab i {
    font-size: 25px;
}

.chat-tab span {
    font-size: 12px;
    font-weight: 600;
}

.chat-tab.active {
    color: #4169e1;
    box-shadow: inset 0 -3px 0 #4169e1;     /* underline: delete this line if you don't want it */
}


/* =========================================
   THE TWO LISTS (only one shows at a time)
========================================= */

.chat-screen {
    display: none;
    padding: 0 18px;
}

.chat-screen.active {
    display: block;
}

.messages-screen.active {
    animation: slideFromLeft 0.25s ease both;
}

.groups-screen.active {
    animation: slideFromRight 0.25s ease both;
}

@keyframes slideFromLeft {
    from { opacity: 0; transform: translateX(-35px); }
    to   { opacity: 1; transform: translateX(0); }
}

@keyframes slideFromRight {
    from { opacity: 0; transform: translateX(35px); }
    to   { opacity: 1; transform: translateX(0); }
}

.conversation-section {
    background: white;
    border-radius: 0 0 16px 16px;
    overflow: hidden;
    box-shadow: 0 3px 15px rgba(0,0,0,0.06);
}

.conversation-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    border-bottom: 1px solid #eee;
}

.conversation-header h2 {
    font-size: 18px;
}

.chat-search-bar {
    padding: 10px 16px;
    border-bottom: 1px solid #eee;
}

.chat-search-bar input {
    width: 100%;
    padding: 10px 14px;
    border-radius: 20px;
    border: none;
    background: #f1f3f5;
    font-size: 14px;
    outline: none;
}

.no-chat-results {
    display: none;
    text-align: center;
    padding: 30px 20px;
    color: #999;
    font-size: 14px;
}


/* ---------- conversations ---------- */

.conversation {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 14px 16px;
    cursor: pointer;
    border-bottom: 1px solid #f0f0f0;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
}

.conversation:last-child {
    border-bottom: none;
}

.conversation:hover {
    background: #f7f8fc;
}

.conversation-avatar,
.group-avatar {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e9edf7;
    color: #4169e1;
    font-size: 26px;
}

.group-avatar {
    background: #eef1ff;
}

.conversation-info {
    min-width: 0;
    flex: 1;
}

.conversation-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 5px;
}

.conversation-top strong {
    font-size: 15px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.conversation-top small {
    color: #888;
    font-size: 11px;
    white-space: nowrap;
}

.conversation-bottom {
    display: flex;
    align-items: center;
    gap: 5px;
}

.conversation-bottom p {
    color: #777;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
}

.conversation-bottom i {
    color: #999;
    font-size: 17px;
}

.conversation-bottom .seen {
    color: #4169e1;
}

.unread-badge {
    min-width: 21px;
    height: 21px;
    padding: 0 6px;
    border-radius: 50%;
    background: #4169e1;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: bold;
    flex-shrink: 0;
}


/* ---------- groups ---------- */

.create-group-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 20px;
    text-decoration: none;
    background: #f1f3f5;
    color: #222;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s ease;
}

.group-item {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 15px 16px;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid #eee;
    transition: 0.2s;
}

.group-item:last-child {
    border-bottom: none;
}

.group-item:hover {
    background: #f7f8fc;
}

.group-info {
    flex: 1;
    min-width: 0;
}

.group-info h3 {
    font-size: 15px;
    margin-bottom: 5px;
}

.group-info p {
    font-size: 13px;
    color: #888;
}

.group-arrow {
    font-size: 22px;
    color: #aaa;
}


/* ---------- empty states ---------- */

.empty-chats,
.empty-groups {
    text-align: center;
    padding: 60px 25px;
}

.empty-chats > i,
.empty-groups > i {
    font-size: 55px;
    color: #4169e1;
    margin-bottom: 12px;
    display: block;
}

.empty-chats h3,
.empty-groups h3 {
    font-size: 19px;
    margin-bottom: 8px;
}

.empty-chats p,
.empty-groups p {
    max-width: 400px;
    margin: 0 auto 20px;
    color: #777;
    line-height: 1.5;
    font-size: 14px;
}

.empty-chats a,
.empty-groups a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    background: #4169e1;
    color: white;
    padding: 11px 16px;
    border-radius: 9px;
    font-size: 14px;
}


/* ---------- delete-chat popup ---------- */

.delete-message-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 20px;
}

.delete-message-overlay.show {
    display: flex;
}

.delete-message-modal {
    background: white;
    color: #1a1a1a;
    border-radius: 16px;
    padding: 24px;
    max-width: 320px;
    width: 100%;
    text-align: center;
}

.delete-message-modal h3 {
    margin-bottom: 10px;
    color: #dc2626;
}

.delete-message-modal p {
    color: #555;
    font-size: 14px;
    margin-bottom: 20px;
}

.delete-message-buttons {
    display: flex;
    gap: 10px;
}

.delete-message-buttons button {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
}

.delete-message-buttons .cancel-btn {
    background: #f1f3f5;
    color: #1a1a1a;
}

.delete-message-buttons .confirm-btn {
    background: #dc2626;
    color: white;
}


/* =========================================
   SMALL PHONES
========================================= */

@media (max-width: 400px) {

    .chat-top {
        padding: 12px 12px 0;
    }

    .chat-screen {
        padding: 0 12px;
    }

    .chat-header h1 {
        font-size: 23px;
    }

    .chat-header p {
        font-size: 12px;
    }

    .create-group-btn span {
        display: none;
    }

    .create-group-btn {
        width: 42px;
        height: 42px;
        padding: 0;
        border-radius: 50%;
        justify-content: center;
    }

}


/* =========================================
   DESKTOP: the global footer is a 220px sidebar on the left
========================================= */

@media (min-width: 768px) {

    body {
        background: #eef1f7;
    }

    .chat-page {
        margin-left: 220px;
        width: calc(100% - 220px);
        min-height: 100vh;
        padding: 25px 20px;
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    .chat-main {
        width: min(700px, 100%);
        height: calc(100vh - 50px);
        display: flex;
        flex-direction: column;
        background: white;
        border-radius: 18px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.10);
    }

    .chat-top {
        flex-shrink: 0;
        padding: 25px 25px 0;
    }

    .chat-screen {
        padding: 0 25px 25px;
    }

    .chat-screen.active {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
    }

}

</style>

</head>


<body>

<div class="chat-page">

    <main class="chat-main">

        <!-- =================================
             SHARED TOP: header, stories, Messages | Groups buttons
        ================================= -->

        <div class="chat-top">

            <div class="chat-header">

                <div>
                    <h1>Chats</h1>
                    <p>Chat with Yunerx users</p>
                </div>

                <a href="/users" class="contacts-button">
                    <i class='bx bx-user-plus'></i>
                    Contacts
                </a>

            </div>


            <div class="stories-section">

                <div class="section-title">

                    <h2>Stories</h2>

                    <a href="/story-privacy" class="story-more" style="text-decoration:none; display:flex; align-items:center;">
                        <i class='bx bx-dots-horizontal-rounded'></i>
                    </a>

                </div>

                <div class="stories-container">

                    <%
                        const storyQueue = [];
                        if (myStory) {
                            storyQueue.push(currentUser);
                        }
                        if (typeof stories !== "undefined") {
                            stories.forEach(function(s) {
                                storyQueue.push(s.username);
                            });
                        }
                        const queueString = storyQueue.join(",");
                    %>

                    <a href="<%= myStory ? '/story/' + currentUser + '?queue=' + queueString : '/createstory' %>" class="story create-story">
                        <div class="story-image">
                            <% if (myStory && myStory.type === "image") { %>
                                <img src="<%= myStory.content %>" style="width:100%; height:100%; object-fit:cover; border-radius:50%;">
                            <% } else if (myStory && myStory.type === "video") { %>
                                <video src="<%= myStory.content %>" style="width:100%; height:100%; object-fit:cover; border-radius:50%;"></video>
                            <% } else if (myStory) { %>
                                <i class='bx bx-user'></i>
                            <% } else { %>
                                <i class='bx bx-plus'></i>
                            <% } %>
                        </div>
                        <span><%= myStory ? "Your story" : "Add story" %></span>
                    </a>

                    <% if (typeof stories !== "undefined") { %>
                        <% stories.forEach(story => { %>
                            <a href="/story/<%= story.username %>?queue=<%= queueString %>" class="story">
                                <div class="story-image">
                                    <% if (story.type === "image") { %>
                                        <img src="<%= story.content %>" style="width:100%; height:100%; object-fit:cover; border-radius:50%;">
                                    <% } else if (story.type === "video") { %>
                                        <video src="<%= story.content %>" style="width:100%; height:100%; object-fit:cover; border-radius:50%;"></video>
                                    <% } else { %>
                                        <i class='bx bx-user'></i>
                                    <% } %>
                                </div>
                                <span><%= story.username %></span>
                            </a>
                        <% }) %>
                    <% } %>

                </div>

            </div>


            <nav class="chat-tabs">

                <button type="button" class="chat-tab active" id="messagesTab">
                    <i class='bx bx-message-rounded-dots'></i>
                    <span>Messages</span>
                </button>

                <button type="button" class="chat-tab" id="groupsTab">
                    <i class='bx bx-group'></i>
                    <span>Groups</span>
                </button>

            </nav>

        </div>


        <!-- =================================
             MESSAGES LIST (below the buttons)
        ================================= -->

        <section class="chat-screen messages-screen active" id="messagesScreen">

            <div class="conversation-section">

                <div class="conversation-header">

                    <h2>Messages</h2>

                    <button type="button" class="search-chat-btn" id="toggleChatSearch">
                        <i class='bx bx-search' id="chatSearchIcon"></i>
                    </button>

                </div>

                <div class="chat-search-bar" id="chatSearchBar" style="display:none;">
                    <input type="text" id="chatSearchInput" placeholder="Search chats...">
                </div>

                <div class="no-chat-results" id="noChatResults">No chats match your search.</div>

                <div class="conversation-list" id="conversationList">

                    <% if (messages && messages.length > 0) { %>

                        <% messages.forEach(msg => { %>

                            <a href="/chat/<%= encodeURIComponent(msg.username) %>" class="conversation" data-username="<%= msg.username %>">

                                <div class="conversation-avatar">
                                    <i class='bx bx-user'></i>
                                </div>

                                <div class="conversation-info">

                                    <div class="conversation-top">
                                        <strong><%= msg.username || "Yunerx User" %></strong>
                                        <small><%= msg.time || "" %></small>
                                    </div>

                                    <div class="conversation-bottom">

                                        <p><%= msg.message || "" %></p>

                                        <% if (msg.unreadCount > 0) { %>
                                            <span class="unread-badge"><%= msg.unreadCount > 99 ? "99+" : msg.unreadCount %></span>
                                        <% } else if (msg.sender === currentUser && msg.seen) { %>
                                            <i class='bx bx-check-double seen'></i>
                                        <% } else if (msg.sender === currentUser) { %>
                                            <i class='bx bx-check'></i>
                                        <% } %>

                                    </div>

                                </div>

                            </a>

                        <% }) %>

                    <% } else { %>

                        <div class="empty-chats">

                            <i class='bx bx-message-rounded-dots'></i>

                            <h3>No messages yet</h3>

                            <p>Find a Yunerx user in your contacts and start a conversation.</p>

                            <a href="/users">
                                <i class='bx bx-user-plus'></i>
                                Find contacts
                            </a>

                        </div>

                    <% } %>

                </div>

            </div>

        </section>


        <!-- =================================
             GROUPS LIST (shows in the same place, below the buttons)
        ================================= -->

        <section class="chat-screen groups-screen" id="groupsScreen">

            <div class="conversation-section">

                <div class="conversation-header">

                    <h2>Groups</h2>

                    <a href="/creategroup" class="create-group-btn">
                        <i class='bx bx-plus'></i>
                        <span>Create</span>
                    </a>

                </div>

                <div class="group-list">

                    <% if (typeof groups !== "undefined" && groups.length > 0) { %>

                        <% groups.forEach(group => { %>

                            <a href="/group/<%= group._id %>" class="group-item">

                                <div class="group-avatar">
                                    <i class='bx bx-group'></i>
                                </div>

                                <div class="group-info">
                                    <h3><%= group.groupName %></h3>
                                    <p><%= group.members ? group.members.length : 0 %> members</p>
                                </div>

                                <i class='bx bx-chevron-right group-arrow'></i>

                            </a>

                        <% }) %>

                    <% } else { %>

                        <div class="empty-groups">

                            <i class='bx bx-group'></i>

                            <h3>No groups yet</h3>

                            <p>Create a group and start chatting with other Yunerx users.</p>

                            <a href="/creategroup">
                                <i class='bx bx-plus'></i>
                                Create group
                            </a>

                        </div>

                    <% } %>

                </div>

            </div>

        </section>

    </main>

</div>


<!-- Delete-chat popup lives outside the sliding sections so it always covers the whole screen -->
<div class="delete-message-overlay" id="deleteChatOverlay">

    <div class="delete-message-modal">

        <h3>Delete this chat?</h3>
        <p>This will permanently delete the entire conversation for both of you.</p>

        <div class="delete-message-buttons">
            <button type="button" class="cancel-btn" id="cancelDeleteChat">Cancel</button>
            <button type="button" class="confirm-btn" id="confirmDeleteChat">Delete</button>
        </div>

    </div>

</div>


<script>

(function () {

    const messagesScreen = document.getElementById("messagesScreen");
    const groupsScreen = document.getElementById("groupsScreen");
    const messagesTab = document.getElementById("messagesTab");
    const groupsTab = document.getElementById("groupsTab");


    /* =========================================
       MESSAGES / GROUPS BUTTONS
    ========================================= */

    function showMessages() {

        messagesScreen.classList.add("active");
        groupsScreen.classList.remove("active");
        messagesTab.classList.add("active");
        groupsTab.classList.remove("active");

    }

    function showGroups() {

        groupsScreen.classList.add("active");
        messagesScreen.classList.remove("active");
        groupsTab.classList.add("active");
        messagesTab.classList.remove("active");

    }

    messagesTab.addEventListener("click", showMessages);
    groupsTab.addEventListener("click", showGroups);

    // /chats?tab=groups opens straight on Groups
    if (new URLSearchParams(window.location.search).get("tab") === "groups") {
        showGroups();
    }


    /* =========================================
       LONG-PRESS A CHAT TO DELETE IT
    ========================================= */

    let chatLongPressTimer;
    let targetChatUsername = null;

    const deleteChatOverlay = document.getElementById("deleteChatOverlay");
    const cancelDeleteChat = document.getElementById("cancelDeleteChat");
    const confirmDeleteChat = document.getElementById("confirmDeleteChat");

    document.querySelectorAll(".conversation[data-username]").forEach(function (conversationEl) {

        const start = () => {

            chatLongPressTimer = setTimeout(() => {

                targetChatUsername = conversationEl.getAttribute("data-username");

                deleteChatOverlay.classList.add("show");

            }, 500);

        };

        const cancel = () => clearTimeout(chatLongPressTimer);

        conversationEl.addEventListener("touchstart", start, { passive: true });
        conversationEl.addEventListener("touchend", cancel);
        conversationEl.addEventListener("touchmove", cancel);

        conversationEl.addEventListener("mousedown", start);
        conversationEl.addEventListener("mouseup", cancel);
        conversationEl.addEventListener("mouseleave", cancel);

        // A long press must not also open the chat when you let go
        conversationEl.addEventListener("click", (e) => {

            if (deleteChatOverlay.classList.contains("show")) {
                e.preventDefault();
            }

        });

    });

    cancelDeleteChat.addEventListener("click", () => {

        deleteChatOverlay.classList.remove("show");
        targetChatUsername = null;

    });

    confirmDeleteChat.addEventListener("click", async () => {

        if (!targetChatUsername) {
            return;
        }

        try {

            const response = await fetch("/chat/" + encodeURIComponent(targetChatUsername) + "/delete", {
                method: "POST"
            });

            const result = await response.json();

            if (result.success) {
                window.location.reload();
            } else {
                alert("Unable to delete chat.");
            }

        } catch (error) {

            console.error("Delete chat error:", error);

            alert("Something went wrong.");

        } finally {

            deleteChatOverlay.classList.remove("show");
            targetChatUsername = null;

        }

    });


    /* =========================================
       SEARCH CHATS
    ========================================= */

    const toggleChatSearch = document.getElementById("toggleChatSearch");
    const chatSearchBar = document.getElementById("chatSearchBar");
    const chatSearchInput = document.getElementById("chatSearchInput");
    const chatSearchIcon = document.getElementById("chatSearchIcon");
    const conversationList = document.getElementById("conversationList");
    const noChatResults = document.getElementById("noChatResults");

    let searchBarOpen = false;

    function filterChats(query) {

        const lowerQuery = query.trim().toLowerCase();

        let visibleCount = 0;

        conversationList.querySelectorAll(".conversation[data-username]").forEach((conversation) => {

            const matches = conversation.getAttribute("data-username").toLowerCase().includes(lowerQuery);

            conversation.style.display = matches ? "" : "none";

            if (matches) {
                visibleCount++;
            }

        });

        noChatResults.style.display = (visibleCount === 0 && lowerQuery !== "") ? "block" : "none";

    }

    toggleChatSearch.addEventListener("click", () => {

        searchBarOpen = !searchBarOpen;

        if (searchBarOpen) {

            chatSearchBar.style.display = "block";
            chatSearchInput.focus();
            chatSearchIcon.classList.replace("bx-search", "bx-x");

        } else {

            chatSearchBar.style.display = "none";
            chatSearchInput.value = "";
            chatSearchIcon.classList.replace("bx-x", "bx-search");

            filterChats("");

        }

    });

    chatSearchInput.addEventListener("input", () => filterChats(chatSearchInput.value));


    /* =========================================
       SWIPE LEFT / RIGHT BETWEEN MESSAGES AND GROUPS
    ========================================= */

    let touchStartX = 0;
    let touchStartTarget = null;

    document.addEventListener("touchstart", (event) => {

        touchStartX = event.changedTouches[0].screenX;
        touchStartTarget = event.target;

    }, { passive: true });

    document.addEventListener("touchend", (event) => {

        // Scrolling the stories row sideways shouldn't switch tabs
        if (touchStartTarget && touchStartTarget.closest(".stories-container")) {
            return;
        }

        if (deleteChatOverlay.classList.contains("show")) {
            return;
        }

        const distance = event.changedTouches[0].screenX - touchStartX;

        if (distance < -60) {
            showGroups();
        }

        if (distance > 60) {
            showMessages();
        }

    }, { passive: true });

})();

</script>


<%- include('partials/footer') %>

<%- include('partials/serviceworker') %>

</body>

</html>
